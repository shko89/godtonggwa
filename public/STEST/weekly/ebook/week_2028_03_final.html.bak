                            </div>

                            <!-- 4. 판상 구조 (완벽하게 산소 1개만 공유하는 육각형 벌집 2D 구조) -->
                            <div class="struct-card">
                                <div class="struct-card-title">판상 구조</div>
                                <svg width="86" height="52" viewBox="0 0 86 52">
                                    <!-- 3개의 사슬을 배치하여 산소가 하나씩 맞물리는 평면 시트(Sheet)를 구성합니다 -->
                                    <g transform="translate(13, -3) scale(0.7)">
                                        <!-- Chain 1 -->
                                        <use href="#tet-unit" transform="translate(9, 10)"/>
                                        <use href="#tet-unit" transform="translate(23, 18) rotate(180)"/>
                                        <use href="#tet-unit" transform="translate(37, 10)"/>
