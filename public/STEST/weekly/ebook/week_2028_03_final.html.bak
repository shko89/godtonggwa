            <!-- Header -->
            <div class="data-header">
                <div class="section-label">SECTION 03</div>
                <h2 class="data-title">생명체를 구성하는 물질 : 단백질과 핵산</h2>
            </div>

            <!-- [자료 1] 생명체의 구성 원소와 질량비 -->
            <div class="info-box">
                <div class="info-box-title">■ [자료 1] 생명체의 구성 원소와 질량비</div>
                <div class="content-box" style="height: 98px;">
                    <svg width="440" height="94" viewBox="0 0 440 94">
