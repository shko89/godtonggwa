                                <circle cx="50" cy="22" r="2.4" fill="url(#e-blue-dot)"/><text x="50" y="22.4" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="90" cy="22" r="2.4" fill="url(#e-blue-dot)"/><text x="90" y="22.4" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
