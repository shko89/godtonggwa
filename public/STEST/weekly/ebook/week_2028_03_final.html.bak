                <text x="28" y="22.5" font-size="6.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">+8</text>
                <!-- Even radial spacing along circle -->
                <circle cx="28.0" cy="10.0" r="3" fill="url(#e-grad)"/>
                <circle cx="28.0" cy="34.0" r="3" fill="url(#e-grad)"/>
                <circle cx="28.0" cy="-1.0" r="3" fill="url(#e-grad)"/>
                <circle cx="47.92" cy="10.5" r="3" fill="url(#e-grad)"/>
