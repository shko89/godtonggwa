@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap');
        
        :root { --primary: #4A90E2;
            --secondary: #F39C12;
            --success: #2ECC71;
            --danger: #E74C3C;
            --bg-color: #F8F9FA;
            --text-dark: #1e293b;
            --card-bg: #FFFFFF; }
.page-scope-quiz_03 .quiz-container, .page-scope-quiz_03.quiz-container {
  width: 100% !important;
            font-family: 'Noto Sans KR', sans-serif;
            color: var(--text-dark);
            padding: 10px 20px;
            box-sizing: border-box;
            background-color: var(--bg-color);
            height: 100%;
            display: block;
            column-count: 1 !important;
            flex: 1 1 100% !important;
}
.page-scope-quiz_03 .header, .page-scope-quiz_03.header {
  text-align: center;
            margin-bottom: 20px;
            width: 100% !important;
            display: block;
}
.page-scope-quiz_03 .header h1, .page-scope-quiz_03.header h1 {
  font-weight: 900;
            color: var(--primary);
            font-size: 18px;
            margin: 0 0 5px 0;
}
.page-scope-quiz_03 .header p, .page-scope-quiz_03.header p {
  color: #64748b;
            font-size: 11px;
            margin: 0;
}
.page-scope-quiz_03 .unit-title, .page-scope-quiz_03.unit-title {
  background-color: var(--primary);
            color: white;
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            margin: 0 0 10px 0;
            box-shadow: 0 2px 4px rgba(74, 144, 226, 0.3);
}
.page-scope-quiz_03 .card + .unit-title, .page-scope-quiz_03.card + .unit-title {
  margin-top: 35px !important;
}
.page-scope-quiz_03 .card, .page-scope-quiz_03.card {
  width: 100% !important;
            background-color: var(--card-bg);
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 12px;
            box-sizing: border-box !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border-left: 4px solid var(--primary);
            display: block;
            page-break-inside: avoid;
            float: none !important;
            clear: both !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
}
.page-scope-quiz_03 .q-type, .page-scope-quiz_03.q-type {
  font-size: 9px;
            font-weight: 900;
            color: #94a3b8;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            display: block;
}
.page-scope-quiz_03 .q-text, .page-scope-quiz_03.q-text {
  width: 100% !important;
            font-size: 11px;
            font-weight: 500;
            margin-bottom: 8px;
            line-height: 1.4;
            word-break: keep-all;
            display: flex;
}
.page-scope-quiz_03 .q-num, .page-scope-quiz_03.q-num {
  font-weight: 900;
            color: var(--primary);
            margin-right: 4px;
            flex-shrink: 0;
}
.page-scope-quiz_03 .q-content, .page-scope-quiz_03.q-content {
  flex: 1;
}
.page-scope-quiz_03 .btn-group, .page-scope-quiz_03.btn-group {
  display: flex;
            gap: 10px;
            width: 100% !important;
}
.page-scope-quiz_03 .ox-btn, .page-scope-quiz_03.ox-btn {
  flex: 1;
            padding: 6px 0;
            font-size: 12px;
            font-weight: 900;
            background-color: #F1F2F6;
            border: 1px solid #DFE4EA;
            border-radius: 6px;
            color: #94a3b8;
            text-align: center;
}
.page-scope-quiz_03 .blank, .page-scope-quiz_03.blank {
  display: inline-block;
            background-color: #E8F0FE;
            color: transparent;
            text-shadow: 0 0 8px rgba(74, 144, 226, 0.7);
            border: 1px dashed var(--primary);
            padding: 1px 10px;
            border-radius: 6px;
            font-weight: 700;
            position: relative;
            vertical-align: middle;
            user-select: none;
            min-width: 40px;
            text-align: center;
}
.page-scope-quiz_03 .blank::after, .page-scope-quiz_03.blank::after {
  content: '?';
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            color: var(--primary);
            text-shadow: none;
            font-size: 10px;
}
.page-scope-quiz_03 .blank.revealed, .page-scope-quiz_03.blank.revealed {
  color: var(--primary) !important;
            text-shadow: none !important;
            background-color: transparent !important;
            border: none !important;
            padding: 0 !important;
}
.page-scope-quiz_03 .blank.revealed::after, .page-scope-quiz_03.blank.revealed::after {
  display: none;
}
.page-scope-quiz_03 .answer-key, .page-scope-quiz_03.answer-key {
  font-size: 9px;
            line-height: 1.5;
            color: #94a3b8;
            background: #fff;
            padding: 10px;
            border-radius: 8px;
            margin-top: 20px;
            border: 1px dashed #cbd5e1;
            text-align: left;
}
</style>

    <!-- Master St.PageFlip Strict Overrides (Must be at the very bottom of head) -->
    <style id="st-pageflip-strict-overrides">
        .stf__item, .stf__item.a4-page, .stf__item.concept-page, .stf__item.spread-page, .stf__item[class*="page-scope-"] {
            position: absolute !important;
            top: 0 !important;
            width: 500px !important;
            height: 707px !important;
            margin: 0 !important;
            box-sizing: border-box !important;
        }
        .stf__item[style*="display: none"], .stf__item[style*="display:none"] {
            display: none !important;
        }
    </style>

    
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { initializeAppCheck, ReCaptchaEnterpriseProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app-check.js";
    import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
    import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
    
    const firebaseConfig = {
        apiKey: "AIzaSyDYljyALj-RbHKjndZYXcOaPzK-Q6xBjjo",
        authDomain: "godtonggwa.firebaseapp.com",
        projectId: "godtonggwa",
        storageBucket: "godtonggwa.firebasestorage.app",
        messagingSenderId: "1087434066468",
        appId: "1:1087434066468:web:00a75c9329543afc76e6b1"
    };

    const app = initializeApp(firebaseConfig);
    try {
        initializeAppCheck(app, {
            provider: new ReCaptchaEnterpriseProvider('6LdgWWstAAAAAJiXWFVDDXeMOHocUBgmQdA62zCR'),
            isTokenAutoRefreshEnabled: true
        });
    } catch (e) {
        console.warn("AppCheck init skipped or already active");
    }
    
    const auth = getAuth(app);
    const db = getFirestore(app);

    onAuthStateChanged(auth, async (user) => {
        if (!user || user.isAnonymous) {
            alert("로그인이 필요하거나 접근 권한이 없습니다.");
            window.location.href = "../../exam.html";
            return;
        }
        try {
            const userDoc = await getDoc(doc(db, "users", user.uid));
            const pkgDoc = await getDoc(doc(db, "users", user.uid, "packages", "weekly_winter_2028"));
            const myPkgDoc = await getDoc(doc(db, "users", user.uid, "my_packages", "weekly_winter_2028"));
            
            const userData = userDoc.exists() ? userDoc.data() : {};
            const isPaid = userData.role === 'admin' || 
                           userData.isPaid === true || 
                           userData.hasAllPass === true || 
                           userData.hasWeeklyPass === true || 
                           userData.subscriptions?.weekly_magazine?.isActive === true || 
                           userData.subscriptions?.all_pass?.isActive === true || 
                           (pkgDoc.exists() && pkgDoc.data().status === 'active') || 
                           (myPkgDoc.exists() && myPkgDoc.data().status === 'active');
                           
            if (!isPaid) {
                alert("갓통과 주간지(WEEKLY) 유료 서비스 신청자만 접근 가능합니다.");
                window.location.href = "../../exam.html";
                return;
            }
            document.body.style.display = 'flex';
        } catch (err) {
            console.error("Auth verification error:", err);
            document.body.style.display = 'flex';
        }
    });

    // 불펌 및 개발자 도구 방지
    document.addEventListener('contextmenu', event => event.preventDefault());
    document.addEventListener('keydown', event => {
        if (event.ctrlKey && (event.key === 's' || event.key === 'c' || event.key === 'u' || event.key === 'a')) {
            event.preventDefault();
        }
        if (event.key === 'F12') {
            event.preventDefault();
        }
    });
</script>


<style>

/* Answer key - Exact Match to User Design (quiz_04 standard) */
.ans-key-card {
    border: 2px dashed #0284c7 !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    padding: 12px 16px !important;
    margin-top: 12px !important;
    box-shadow: 0 2px 6px rgba(2, 132, 199, 0.06) !important;
    box-sizing: border-box !important;
    width: 100% !important;
}
.ans-key-title {
    font-size: 13px !important;
    font-weight: 900 !important;
    color: #0284c7 !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    border-bottom: 1.5px solid #bae6fd !important;
    padding-bottom: 6px !important;
    margin-bottom: 10px !important;
    letter-spacing: -0.2px !important;
}
.ans-key-title .bullet {
    font-size: 11px !important;
    color: #0284c7 !important;
}
.ans-key-content {
    font-size: 9.3px !important;
    line-height: 1.8 !important;
    color: #334155 !important;
    word-break: keep-all !important;
}
.ans-key-content b {
    color: #0f172a !important;
    font-weight: 800 !important;
}

</style>
