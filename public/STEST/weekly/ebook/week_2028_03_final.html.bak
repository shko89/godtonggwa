                <!-- [자료 3] 공유 결합 (H2O 형성) - Compact Padding -->
                <div class="info-box">
                    <div class="info-box-title">■ [자료 3] 공유 결합 (H₂O 분자의 형성)</div>
                    <div class="content-box" style="height: 90px; display: flex; align-items: center; justify-content: center;">
                        <svg width="430" height="88" viewBox="0 0 430 88">
<defs>
    <radialGradient id="nuc-red" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#f87171" />
        <stop offset="60%" stop-color="#dc2626" />
