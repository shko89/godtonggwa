<body>

<!-- Top Navigation Bar (50px Fixed Header) -->
<div id="top-nav" style="position: fixed; top: 0; left: 0; right: 0; height: 50px; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; z-index: 10000; box-sizing: border-box;">
    <!-- Left Section -->
    <div style="display: flex; align-items: center; gap: 10px;">
        <button onclick="window.closeEbook(event)" ontouchstart="window.closeEbook(event)" style="background: #ef4444; border: none; color: white; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);">
            <span style="font-size: 13px; font-weight: 900;">✖</span> 닫기
        </button>
        <div style="font-family: 'Roboto', sans-serif; font-weight: 900; font-size: 14px; color: #38bdf8; letter-spacing: 0.5px;">
            GOTONGGWA <span style="background: #0284c7; color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px;">VOL.03</span>
        </div>
        <button id="btn-toc-toggle" onclick="window.toggleTocDrawer(event)" ontouchstart="window.toggleTocDrawer(event)" style="background: #1e293b; border: 1px solid #0284c7; color: #38bdf8; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(2, 132, 199, 0.2); transition: all 0.2s;">
            <span style="font-size: 14px;">📑</span> 목차
        </button>
    </div>
    
    <!-- Right Section -->
    <div style="display: flex; align-items: center; gap: 8px;">
        <button id="btn-mode-toggle" onclick="window.toggleDrawingMode(event)" ontouchstart="window.toggleDrawingMode(event)" style="background: #38bdf8; border: none; color: #0f172a; padding: 6px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 800; cursor: pointer;">
            📖 보기 모드
        </button>
        <div id="drawing-tools" style="display: none; align-items: center; gap: 6px; background: #1e293b; padding: 3px 8px; border-radius: 6px; border: 1px solid #334155;">
            <button class="pen-btn active" onclick="window.setPen('#0f172a', this, false, event)" style="width: 20px; height: 20px; border-radius: 50%; background: #0f172a; border: 2px solid white; cursor: pointer;"></button>
            <button class="pen-btn" onclick="window.setPen('#ef4444', this, false, event)" style="width: 20px; height: 20px; border-radius: 50%; background: #ef4444; border: 2px solid transparent; cursor: pointer;"></button>
            <button class="pen-btn" onclick="window.setPen('#2563eb', this, false, event)" style="width: 20px; height: 20px; border-radius: 50%; background: #2563eb; border: 2px solid transparent; cursor: pointer;"></button>
            <button class="pen-btn" onclick="window.setPen('rgba(250, 204, 21, 0.4)', this, true, event)" style="background: #fde047; color: #854d0e; border: 1px solid #facc15; font-size: 10px; font-weight: bold; border-radius: 4px; padding: 2px 6px; cursor: pointer;">형광펜</button>
            <button onclick="window.setEraser(this, event)" style="background: #334155; color: #f8fafc; border: 1px solid #475569; font-size: 10px; font-weight: bold; border-radius: 4px; padding: 2px 6px; cursor: pointer;">지우개</button>
            <button onclick="window.clearAllCanvas(event)" style="background: #475569; color: #f8fafc; border: 1px solid #64748b; font-size: 10px; font-weight: bold; border-radius: 4px; padding: 2px 6px; cursor: pointer;">전체 지우기</button>
        </div>
        <div id="page-jump-pill" onclick="window.togglePageJumpModal(event)" ontouchstart="window.togglePageJumpModal(event)" style="font-family: 'Roboto', sans-serif; font-size: 13px; font-weight: 700; color: #94a3b8; background: #1e293b; padding: 4px 14px; border-radius: 20px; border: 1px solid #334155; cursor: pointer; display: flex; align-items: center; gap: 4px;">
            <span id="current-page-num" style="color: #38bdf8; font-weight: 900;">1</span> / <span id="total-page-num">41</span> P
        </div>
    </div>
</div>

<!-- TOC Overlay & Sliding Drawer -->
<div id="toc-overlay" onclick="window.closeTocDrawer()" ontouchstart="window.closeTocDrawer()" style="display: none; position: fixed; top: 50px; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px); z-index: 10001; opacity: 0; transition: opacity 0.2s;"></div>
<div id="toc-drawer" style="position: fixed; top: 50px; left: 0; bottom: 0; width: 320px; max-width: 85vw; background: #0f172a; border-right: 1px solid rgba(56, 189, 248, 0.25); box-shadow: 10px 0 30px rgba(0,0,0,0.6); z-index: 10002; transform: translateX(-100%); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; box-sizing: border-box;">
    <div style="padding: 16px 20px; border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 16px;">📑</span>
            <span style="font-size: 15px; font-weight: 900; color: #f8fafc; letter-spacing: -0.5px;">빠른 목차 이동</span>
        </div>
        <button onclick="window.closeTocDrawer()" ontouchstart="window.closeTocDrawer()" style="background: transparent; border: none; color: #94a3b8; font-size: 18px; cursor: pointer; padding: 4px 8px; border-radius: 4px; line-height: 1;">✕</button>
    </div>
    <div style="padding: 14px 16px; overflow-y: auto; flex-grow: 1; display: flex; flex-direction: column; gap: 8px;">
<div class="toc-jump-item" onclick="window.goToPage(1)">
