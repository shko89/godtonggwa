<div class="page-wrapper page-scope-page10" style="margin-top: 40px; display: flex; justify-content: center;">
<div class="a4-page page-left">

                <!-- Header -->
                <div class="data-header">
                    <div class="section-label">SECTION 02</div>
                    <h2 class="data-title">지각을 구성하는 물질 : 규산염 광물</h2>
                </div>

                <!-- [자료 1] 지각의 구성 원소와 질량비 -->
                <div class="info-box">
                    <div class="info-box-title">■ [자료 1] 지각의 구성 원소와 질량비</div>
                    <div class="content-box" style="height: 100px; display: flex; align-items: center; justify-content: center;">
                        <svg width="440" height="96" viewBox="0 0 440 96">
                            <!-- Left: SVG Donut Chart for Earth Crust Mass Composition -->
                            <g transform="translate(10, 0)">
                                <g transform="translate(56, 46)">
                                    <!-- Oxygen O: 46.6% -->
                                    <path d="M 0 0 L 0 -40 A 40 40 0 0 1 39.0 8.4 Z" fill="#0284c7"/>
                                    <!-- Silicon Si: 27.7% -->
                                    <path d="M 0 0 L 39.0 8.4 A 40 40 0 0 1 -1.7 39.95 Z" fill="#38bdf8"/>
                                    <!-- Aluminum Al: 8.1% -->
                                    <path d="M 0 0 L -1.7 39.95 A 40 40 0 0 1 -17.9 35.7 Z" fill="#64748b"/>
                                    <!-- Iron Fe: 5.0% -->
                                    <path d="M 0 0 L -17.9 35.7 A 40 40 0 0 1 -28.1 28.4 Z" fill="#f59e0b"/>
                                    <!-- Others: 12.6% -->
                                    <path d="M 0 0 L -28.1 28.4 A 40 40 0 0 1 0 -40 Z" fill="#cbd5e1"/>

                                    <!-- Inner Donut Hole -->
                                    <circle cx="0" cy="0" r="21" fill="#ffffff"/>
                                    <text x="0" y="-3" font-size="7" font-weight="900" fill="#0f172a" text-anchor="middle">지각 질량비</text>
                                    <text x="0" y="6" font-size="6" font-weight="bold" fill="#0284c7" text-anchor="middle">O+Si ≈ 74.3%</text>
                                </g>

                                <text x="56" y="93" font-size="8" font-weight="bold" fill="#0f172a" text-anchor="middle">지각의 구성 원소 질량비 (%)</text>
                            </g>

                            <!-- Right: Legend & Percentage Breakdown Cards -->
                            <g transform="translate(125, 4)">
                                <!-- O & Si Combined Card -->
                                <rect x="0" y="0" width="295" height="26" rx="5" fill="#f0f9ff" stroke="#bae6fd" stroke-width="1.2"/>
                                <text x="10" y="11" font-size="8.8" font-weight="900" fill="#0369a1">산소(O) + 규소(Si) = 약 74.3% (전체의 3/4)</text>
                                <text x="10" y="21" font-size="7.5" font-weight="bold" fill="#334155">지각에 가장 풍부한 원소 1, 2위 ➔ 대부분 <tspan fill="#0284c7">규산염 광물</tspan> 형성</text>

                                <!-- Grid of Element Ranks -->
                                <g transform="translate(0, 30)">
                                    <!-- Row 1 -->
                                    <rect x="0" y="0" width="69" height="21" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                    <text x="34.5" y="8.5" font-size="7.2" font-weight="bold" fill="#0284c7" text-anchor="middle">1위 산소(O)</text>
                                    <text x="34.5" y="17" font-size="7.8" font-weight="900" fill="#0f172a" text-anchor="middle">46.6%</text>

                                    <rect x="74" y="0" width="69" height="21" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                    <text x="108.5" y="8.5" font-size="7.2" font-weight="bold" fill="#0284c7" text-anchor="middle">2위 규소(Si)</text>
                                    <text x="108.5" y="17" font-size="7.8" font-weight="900" fill="#0f172a" text-anchor="middle">27.7%</text>

                                    <rect x="148" y="0" width="69" height="21" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                    <text x="182.5" y="8.5" font-size="7.2" font-weight="bold" fill="#475569" text-anchor="middle">3위 알루미늄</text>
                                    <text x="182.5" y="17" font-size="7.8" font-weight="900" fill="#0f172a" text-anchor="middle">8.1%</text>

                                    <rect x="222" y="0" width="73" height="21" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                    <text x="258.5" y="8.5" font-size="7.2" font-weight="bold" fill="#475569" text-anchor="middle">4위 철(Fe)</text>
                                    <text x="258.5" y="17" font-size="7.8" font-weight="900" fill="#0f172a" text-anchor="middle">5.0%</text>

                                    <!-- Row 2 -->
                                    <rect x="0" y="25" width="295" height="17" rx="4" fill="#f1f5f9"/>
                                    <text x="147.5" y="36" font-size="7.2" font-weight="bold" fill="#64748b" text-anchor="middle">기타 원소: 칼슘(Ca 3.6%) > 나트륨(Na 2.8%) > 칼륨(K 2.6%) > 마그네슘(Mg 2.1%)</text>
                                </g>
                            </g>
                        </svg>
                    </div>
                </div>

                <!-- Master SVG Defs -->
                <svg style="width:0; height:0; position:absolute;">
                    <defs>
