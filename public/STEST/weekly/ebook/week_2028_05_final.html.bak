        .node.leaf .desc { color: #64748b; font-size: 9px; line-height: 1.35; word-break: keep-all; }
        .node.leaf.red { border-color: #fca5a5; background-color: #fef2f2; }
        .node.leaf.red .font-bold { color: #dc2626; }
