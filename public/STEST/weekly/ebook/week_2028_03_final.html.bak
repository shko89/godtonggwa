                </div>
            </div>

            <!-- [자료 2] 단백질 (FIXED: PERFECTLY BALANCED & CENTERED WITHIN 440px CANVAS, ZERO OVERFLOW PAST RIGHT BORDER) -->
            <div class="info-box" style="flex-grow: 1; display: flex; flex-direction: column;">
                <div class="info-box-title">■ [자료 2] 탄소 화합물과 단백질의 구조적 특징</div>
                
                <div class="sub-box" style="margin-top: 0; margin-bottom: 4px; background-color: #f8fafc;">
                    <ul class="bullet-list">
                        <li><b style="color:#0284c7;">탄소 화합물:</b> 탄소(C) 원자가 최대 4개의 공유 결합을 형성하여 기본 골격을 이루고, 여기에 수소(H), 산소(O), 질소(N) 등이 결합하여 만들어진 복잡하고 다양한 화합물. (예: 단백질, 핵산, 탄수화물, 지질)</li>
                    </ul>
                </div>

                <div class="content-box" style="padding: 6px 2px; margin-bottom: 4px;">
                    <svg width="100%" height="155" viewBox="0 0 440 155">
                        <defs>
                            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/></marker>
                        </defs>

                        <!-- Headers at y=12 -->
                        <text x="75" y="12" font-size="8.8" font-weight="900" fill="#0f172a" text-anchor="middle">① 아미노산 (단위체)</text>
                        <text x="235" y="12" font-size="8.8" font-weight="900" fill="#0f172a" text-anchor="middle">② 폴리펩타이드</text>
                        <text x="375" y="12" font-size="8.8" font-weight="900" fill="#0f172a" text-anchor="middle">③ 단백질</text>

                        <!-- Step 1: Amino Acid Monomer (Shifted left to translate x=38 so left amino group box sits at x=14) -->
                        <g transform="translate(38, 32)">
                            <circle cx="40" cy="42" r="11" fill="#cbd5e1" stroke="#94a3b8"/>
                            <text x="40" y="45" font-size="8.5" font-weight="bold" fill="#0f172a" text-anchor="middle">C</text>
                            
                            <line x1="29" y1="42" x2="18" y2="42" stroke="#94a3b8" stroke-width="2"/>
                            <rect x="-24" y="30" width="42" height="24" rx="4" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.2"/>
                            <text x="-3" y="44.5" font-size="7.8" font-weight="bold" fill="#1d4ed8" text-anchor="middle">아미노기</text>

                            <line x1="51" y1="42" x2="62" y2="42" stroke="#94a3b8" stroke-width="2"/>
                            <rect x="62" y="30" width="44" height="24" rx="4" fill="#fef2f2" stroke="#ef4444" stroke-width="1.2"/>
                            <text x="84" y="44.5" font-size="7.8" font-weight="bold" fill="#b91c1c" text-anchor="middle">카복실기</text>

                            <line x1="40" y1="31" x2="40" y2="19" stroke="#94a3b8" stroke-width="2"/>
                            <circle cx="40" cy="8" r="11" fill="#fef08a" stroke="#d97706" stroke-width="1.2"/>
                            <text x="40" y="11" font-size="8" font-weight="bold" fill="#b45309" text-anchor="middle">R기</text>
                            
                            <line x1="40" y1="53" x2="40" y2="62" stroke="#94a3b8" stroke-width="2"/>
                            <text x="40" y="71" font-size="8" font-weight="bold" fill="#475569" text-anchor="middle">H</text>

                            <text x="40" y="90" font-size="6.8" fill="#64748b" text-anchor="middle">R기(곁사슬)에 따라</text>
                            <text x="40" y="99" font-size="6.8" fill="#64748b" text-anchor="middle">약 20종류로 구분</text>
                        </g>

                        <!-- Arrow 1 -->
                        <path d="M 148 74 L 174 74" fill="none" stroke="#94a3b8" stroke-width="2.5" marker-end="url(#arrow)"/>
                        <text x="161" y="62" font-size="7.2" font-weight="bold" fill="#dc2626" text-anchor="middle">펩타이드 결합</text>
                        <text x="161" y="87" font-size="6.2" fill="#64748b" text-anchor="middle">(물 분자 빠져나감)</text>

                        <!-- Step 2: Polypeptide Chain -->
                        <g transform="translate(186, 32)">
                            <path d="M 8 42 L 28 32 L 48 52 L 68 37 L 88 47" fill="none" stroke="#94a3b8" stroke-width="2.5"/>
                            
                            <circle cx="8" cy="42" r="8" fill="#fca5a5" stroke="#ef4444" stroke-width="1.2"/>
                            <rect x="19" y="23" width="18" height="18" rx="3" fill="#93c5fd" stroke="#3b82f6" stroke-width="1.2"/>
                            <polygon points="48,41 39,58 57,58" fill="#86efac" stroke="#22c55e" stroke-width="1.2"/>
                            <polygon points="68,28 77,37 68,46 59,37" fill="#fde047" stroke="#eab308" stroke-width="1.2"/>
                            <polygon points="88,38 96,42 96,51 88,55 80,51 80,42" fill="#d8b4fe" stroke="#a855f7" stroke-width="1.2"/>
                            
                            <text x="48" y="78" font-size="7" font-weight="bold" fill="#475569" text-anchor="middle">다양한 종류의 아미노산이</text>
                            <text x="48" y="87" font-size="7" font-weight="bold" fill="#475569" text-anchor="middle">수많은 배열로 사슬 형성</text>
                        </g>

                        <!-- Arrow 2 -->
                        <path d="M 292 74 L 318 74" fill="none" stroke="#94a3b8" stroke-width="2.5" marker-end="url(#arrow)"/>
                        <text x="305" y="62" font-size="7.2" font-weight="bold" fill="#0284c7" text-anchor="middle">구부러지고 접힘</text>
                        <text x="305" y="87" font-size="6.2" fill="#64748b" text-anchor="middle">(입체 구조 형성)</text>

                        <!-- Step 3: 3D Protein Structure (Shifted left to translate x=332, rightmost text at x=425, SAFE 15px MARGIN) -->
                        <g transform="translate(332, 32)">
                            <path d="M15,65 C10,30 35,20 45,40 C55,60 35,85 60,90 C80,95 90,70 80,50 C70,30 55,25 70,20" fill="none" stroke="#38bdf8" stroke-width="11" stroke-linecap="round"/>
                            <path d="M15,65 C10,30 35,20 45,40 C55,60 35,85 60,90 C80,95 90,70 80,50 C70,30 55,25 70,20" fill="none" stroke="#bae6fd" stroke-width="5" stroke-linecap="round"/>
                            
                            <text x="42" y="110" font-size="7.2" font-weight="bold" fill="#b91c1c" text-anchor="middle">고유 입체 구조 = 특정한 기능</text>
                        </g>
                    </svg>
                </div>

                <div class="sub-box">
                    <div class="sub-box-title">■ 단백질의 형성 및 기능 요약:</div>
                    <ul class="bullet-list">
                        <li><b>단위체(아미노산):</b> 생명체를 구성하는 아미노산은 약 20종류. 각 아미노산은 <b>곁사슬(R기)</b>의 구조가 다름.</li>
                        <li><b>펩타이드 결합:</b> 두 아미노산의 아미노기와 카복실기 사이에서 <b>물(H₂O) 분자가 빠져나가면서(축합 중합)</b> 형성되는 공유 결합. 이렇게 연결된 긴 사슬을 <b>폴리펩타이드</b>라고 함.</li>
                        <li><b>입체 구조와 기능:</b> 아미노산의 <b>종류, 수, 배열 순서</b>에 따라 폴리펩타이드가 꺾이고 접히는 방식이 달라짐. 즉, 아미노산 서열이 단백질의 <b>고유한 입체 구조</b>를 결정하고, 이 입체 구조가 단백질의 <b>기능</b>을 결정함.</li>
                        <li><b>단백질의 주요 기능:</b> 효소(물질대사 촉진), 호르몬(생리 작용 조절), 항체(방어 작용), 몸의 주요 구성 성분(근육, 뼈, 머리카락 등), 에너지원(4kcal/g).</li>
                        <li><b>변성:</b> 고열이나 강한 산(pH 변화)에 노출되면 단백질의 입체 구조가 파괴되어 고유한 기능을 상실함.</li>
                    </ul>
                </div>

                <!-- PROTEIN DENATURATION MODEL -->
                <div class="content-box" style="margin-top: 4px; padding: 4px; background-color: #f8fafc;">
                    <div style="font-size: 8px; font-weight: 800; color: #7c3aed; margin-bottom: 2px; width: 100%; text-align: left; padding-left: 4px;">■ 단백질의 변성 모형 (Denaturation)</div>
                    <svg width="440" height="84" viewBox="0 0 440 84">
                        <defs>
                            <marker id="purple-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#8b5cf6"/></marker>
                        </defs>

                        <g transform="translate(45, 0)">
                            <path d="M15,38 C10,16 30,10 38,22 C45,34 30,48 48,52 C66,56 72,40 66,28 C60,16 46,13 58,10" fill="none" stroke="#0284c7" stroke-width="8" stroke-linecap="round"/>
                            <path d="M15,38 C10,16 30,10 38,22 C45,34 30,48 48,52 C66,56 72,40 66,28 C60,16 46,13 58,10" fill="none" stroke="#7dd3fc" stroke-width="4" stroke-linecap="round"/>
                            <text x="42" y="72" font-size="8.5" font-weight="bold" fill="#0f172a" text-anchor="middle">정상 단백질</text>
                        </g>

                        <g transform="translate(160, 4)">
                            <text x="60" y="16" font-size="8.5" font-weight="900" fill="#6d28d9" text-anchor="middle">변성 (열 / pH 변화)</text>
                            <path d="M 20 38 Q 60 16 100 32" fill="none" stroke="#8b5cf6" stroke-width="3" marker-end="url(#purple-arrow)"/>
                        </g>

                        <g transform="translate(300, 0)">
                            <path d="M10,46 Q 20,8 30,28 T 50,18 T 70,38 T 90,13 T 100,48" fill="none" stroke="#0284c7" stroke-width="6" stroke-linecap="round"/>
                            <path d="M10,46 Q 20,8 30,28 T 50,18 T 70,38 T 90,13 T 100,48" fill="none" stroke="#7dd3fc" stroke-width="3" stroke-linecap="round"/>
                            <text x="55" y="72" font-size="8.5" font-weight="bold" fill="#0f172a" text-anchor="middle">변성된 단백질</text>
                        </g>
                    </svg>
                </div>
            </div>

            
        </div>
    </div>

<div class="page-num">- 20 -</div>
</div>
