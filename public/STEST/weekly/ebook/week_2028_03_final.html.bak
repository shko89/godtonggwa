                                        <use href="#tet-unit" transform="translate(51, 34)"/>
                                        <use href="#tet-unit" transform="translate(65, 42) rotate(180)"/>
                                        <use href="#tet-unit" transform="translate(79, 34)"/>

                                        <!-- Chain 3 -->
                                        <use href="#tet-unit" transform="translate(9, 58)"/>
                                        <use href="#tet-unit" transform="translate(23, 66) rotate(180)"/>
                                        <use href="#tet-unit" transform="translate(37, 58)"/>
                                        <use href="#tet-unit" transform="translate(51, 66) rotate(180)"/>
