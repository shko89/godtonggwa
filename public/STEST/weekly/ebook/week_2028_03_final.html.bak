<script src="https://cdn.jsdelivr.net/npm/page-flip/dist/js/page-flip.browser.js"></script>
<script>
// ==========================================
// 1. Close Button Logic (Reliable Navigation)
// ==========================================

// ==========================================
// TOC Navigation & Page Jump Popover
// ==========================================
window.toggleTocDrawer = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    const drawer = document.getElementById('toc-drawer');
    const overlay = document.getElementById('toc-overlay');
    if (!drawer || !overlay) return;
    const isOpen = drawer.style.transform === 'translateX(0px)';
    if (isOpen) {
        window.closeTocDrawer();
    } else {
        window.openTocDrawer();
    }
};

window.openTocDrawer = function() {
    const drawer = document.getElementById('toc-drawer');
    const overlay = document.getElementById('toc-overlay');
    if (drawer) drawer.style.transform = 'translateX(0px)';
    if (overlay) {
        overlay.style.display = 'block';
        setTimeout(() => overlay.style.opacity = '1', 10);
    }
};

window.closeTocDrawer = function() {
    const drawer = document.getElementById('toc-drawer');
    const overlay = document.getElementById('toc-overlay');
    if (drawer) drawer.style.transform = 'translateX(-100%)';
    if (overlay) {
        overlay.style.opacity = '0';
        setTimeout(() => overlay.style.display = 'none', 200);
    }
};

window.goToPage = function(pageNum) {
    if (!pageFlip) return;
    const targetIdx = Math.max(0, pageNum - 1);
    pageFlip.flip(targetIdx);
    window.closeTocDrawer();
    window.closePageJumpModal();
};

window.togglePageJumpModal = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    const pop = document.getElementById('page-jump-popover');
    if (!pop) return;
    if (pop.style.display === 'flex') {
        pop.style.display = 'none';
    } else {
        pop.style.display = 'flex';
        const input = document.getElementById('page-jump-input');
        if (input) {
            if (pageFlip) input.value = pageFlip.getCurrentPageIndex() + 1;
            input.focus();
        }
    }
};

window.closePageJumpModal = function() {
    const pop = document.getElementById('page-jump-popover');
    if (pop) pop.style.display = 'none';
};

window.submitPageJump = function() {
    const input = document.getElementById('page-jump-input');
    if (!input || !pageFlip) return;
    const val = parseInt(input.value, 10);
    const maxP = pageFlip.getPageCount();
    if (!isNaN(val) && val >= 1 && val <= maxP) {
        window.goToPage(val);
    }
};

window.closeEbook = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
        try { e.preventDefault(); } catch(err){}
    }
    if (window.opener && !window.opener.closed) {
        window.close();
        return;
    }
    if (document.referrer && (document.referrer.indexOf(window.location.host) !== -1 || document.referrer.indexOf('exam') !== -1)) {
        window.location.href = document.referrer;
        return;
    }
    if (window.history && window.history.length > 1) {
        window.history.back();
        setTimeout(function() {
            window.location.href = "../../exam.html";
        }, 300);
        return;
    }
    window.location.href = "../../exam.html";
};

// ==========================================
// 2. Interactive Quiz Handlers (OX & Blanks)
// ==========================================
window.checkOX = function(btn, choice, event) {
    if (event) {
        try { event.stopPropagation(); } catch(err){}
    }
    var group = btn.closest('.btn-group') || btn.parentElement;
    if (!group || group.dataset.answered) return;
    var answer = group.dataset.answer;
    group.dataset.answered = "true";
    
    var btns = group.querySelectorAll('.ox-btn');
    if (choice === answer) {
        btn.style.setProperty('background-color', '#dcfce7', 'important');
        btn.style.setProperty('color', '#16a34a', 'important');
        btn.style.setProperty('border-color', '#16a34a', 'important');
    } else {
        btn.style.setProperty('background-color', '#fee2e2', 'important');
        btn.style.setProperty('color', '#dc2626', 'important');
        btn.style.setProperty('border-color', '#dc2626', 'important');
        btns.forEach(function(b) {
            if (b.textContent.trim() === answer) {
                b.style.setProperty('background-color', '#dcfce7', 'important');
                b.style.setProperty('color', '#16a34a', 'important');
                b.style.setProperty('border-color', '#16a34a', 'important');
            }
        });
    }
};

window.revealBlank = function(el, event) {
    if (event) {
        try { event.stopPropagation(); } catch(err){}
    }
    el.classList.add('revealed');
};

// ==========================================
// 3. Drawing Engine (보기 모드 & 쓰기/필기 모드)
// ==========================================
let isDrawingMode = false;
let currentPenColor = '#0f172a';
let currentPenWidth = 2.5;
let isHighlighter = false;
let isEraserMode = false;

window.toggleDrawingMode = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    isDrawingMode = !isDrawingMode;
    const btn = document.getElementById('btn-mode-toggle');
    const tools = document.getElementById('drawing-tools');
    const canvases = document.querySelectorAll('.draw-layer');

    if (isDrawingMode) {
        if (btn) {
            btn.textContent = '✏️ 쓰기 모드';
            btn.style.backgroundColor = '#f59e0b';
            btn.style.color = '#ffffff';
        }
        if (tools) tools.style.display = 'flex';
        canvases.forEach(cvs => {
            cvs.style.pointerEvents = 'auto';
        });
    } else {
        if (btn) {
            btn.textContent = '📖 보기 모드';
            btn.style.backgroundColor = '#38bdf8';
            btn.style.color = '#0f172a';
        }
        if (tools) tools.style.display = 'none';
        canvases.forEach(cvs => {
            cvs.style.pointerEvents = 'none';
        });
    }
};

window.setPen = function(color, btn, isHl, e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    isEraserMode = false;
    isHighlighter = !!isHl;
    currentPenColor = color;
    document.querySelectorAll('.pen-btn').forEach(b => b.style.borderColor = 'transparent');
    if (btn) btn.style.borderColor = '#ffffff';
    document.querySelectorAll('.tool-btn').forEach(b => {
        if (b.textContent.includes('지우개')) b.classList.remove('active');
    });
};

window.setThickness = function(w, btn, e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    currentPenWidth = w;
    document.querySelectorAll('.tool-btn').forEach(b => {
        if (['얇게', '보통', '두껍'].includes(b.textContent)) b.classList.remove('active');
    });
    if (btn) btn.classList.add('active');
};

window.setEraser = function(btn, e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    isEraserMode = true;
    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
};

window.clearAllCanvas = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    if (!pageFlip) return;
    const currIdx = pageFlip.getCurrentPageIndex();
    const pages = document.querySelectorAll('#flipbook .stf__item');
    if (pages[currIdx]) {
        const cvs = pages[currIdx].querySelector('.draw-layer');
        if (cvs) {
            const ctx = cvs.getContext('2d');
            ctx.clearRect(0, 0, cvs.width, cvs.height);
        }
    }
    if (pages[currIdx + 1]) {
        const cvs = pages[currIdx + 1].querySelector('.draw-layer');
        if (cvs) {
            const ctx = cvs.getContext('2d');
            ctx.clearRect(0, 0, cvs.width, cvs.height);
        }
    }
};

function setupCanvasDrawing(canvas) {
    const ctx = canvas.getContext('2d');
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    let isDrawing = false;
    let lastX = 0;
    let lastY = 0;

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        return {
            x: (e.clientX - rect.left) * scaleX,
            y: (e.clientY - rect.top) * scaleY
        };
    }

    function handlePointerDown(e) {
        if (!isDrawingMode) return;
        if (!e.isPrimary) return;
        if (e.pointerType === 'touch') return;

        e.stopPropagation();
        if (e.cancelable) e.preventDefault();

        isDrawing = true;
        try { canvas.setPointerCapture(e.pointerId); } catch(err){}

        if (isEraserMode) {
            ctx.globalCompositeOperation = 'destination-out';
            ctx.lineWidth = currentPenWidth * 8; 
            ctx.strokeStyle = 'rgba(0,0,0,1)';
        } else {
            if (isHighlighter) {
                ctx.globalCompositeOperation = 'multiply';
                ctx.lineWidth = 20;
                ctx.strokeStyle = currentPenColor;
            } else {
                ctx.globalCompositeOperation = 'source-over';
                ctx.lineWidth = currentPenWidth * 2; 
                ctx.strokeStyle = currentPenColor;
            }
        }

        const pos = getPos(e);
        lastX = pos.x;
        lastY = pos.y;

        ctx.beginPath();
        ctx.arc(lastX, lastY, ctx.lineWidth / 2, 0, Math.PI * 2);
        ctx.fillStyle = ctx.strokeStyle;
        ctx.fill();
    }

    function handlePointerMove(e) {
        if (!isDrawing || !isDrawingMode) return;
        if (e.pointerType === 'touch') return;

        e.stopPropagation();
        if (e.cancelable) e.preventDefault();

        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();

        lastX = pos.x;
        lastY = pos.y;
    }

    function handlePointerUp(e) {
        if (!isDrawing) return;
        isDrawing = false;
        try { canvas.releasePointerCapture(e.pointerId); } catch(err){}
    }

    canvas.addEventListener('pointerdown', handlePointerDown);
    canvas.addEventListener('pointermove', handlePointerMove);
    canvas.addEventListener('pointerup', handlePointerUp);
    canvas.addEventListener('pointercancel', handlePointerUp);
}

// ==========================================
// 4. St.PageFlip Viewer & Touch System
// ==========================================
let pageFlip = null;
let currentZoom = 1.0;
let panX = 0;
let panY = 0;
let lastTouchEndTime = 0;

function isPortraitMode() {
    const w = window.innerWidth;
    const h = window.innerHeight;
    return (h > w) || (w < 768);
}

function resizeFlipbook() {
    const fbContainer = document.getElementById('flipbook-container');
    const scaleWrapper = document.getElementById('scale-wrapper');
    if (!fbContainer || fbContainer.style.display === 'none' || !scaleWrapper) return;

    const winW = fbContainer.clientWidth || window.innerWidth;
    const winH = fbContainer.clientHeight || window.innerHeight;
    
    const isPortrait = (pageFlip && pageFlip.getOrientation() === 'portrait') || isPortraitMode();
    const targetW = isPortrait ? 500 : 1000;
    const targetH = 707;

    if (currentZoom <= 1.05) {
        panX = 0;
        panY = 0;
    }

    const scaleW = (winW * (isPortrait ? 0.96 : 0.95)) / targetW;
    const scaleH = (winH * (isPortrait ? 0.88 : 0.92)) / targetH;
    let baseScale = Math.min(scaleW, scaleH);
    let totalScale = baseScale * currentZoom;

    scaleWrapper.style.width = targetW + 'px';
    scaleWrapper.style.height = targetH + 'px';
    scaleWrapper.style.transform = 'translate(calc(-50% + ' + panX + 'px), calc(-50% + ' + panY + 'px)) scale(' + totalScale + ')';

    if (pageFlip) {
        pageFlip.update();
    }
}

function zoomFlipbook(delta) {
    currentZoom = Math.min(Math.max(currentZoom + delta, 0.6), 3.5);
    if (currentZoom <= 1.05) {
        panX = 0;
        panY = 0;
    }
    resizeFlipbook();
}

function initFlipbookEngine() {
    const fbElement = document.getElementById('flipbook');
    const scaleWrapper = document.getElementById('scale-wrapper');
    if (!fbElement || pageFlip) return;

    const topWrappers = Array.from(document.querySelectorAll('#main-content > .page-wrapper'));
    fbElement.innerHTML = '';

    topWrappers.forEach(w => {
        const a4Page = w.querySelector('.a4-page') || w.querySelector('.concept-page') || w.querySelector('.spread-page') || w.firstElementChild;
        if (!a4Page) return;

        const clone = a4Page.cloneNode(true);
        clone.style.boxShadow = "none";
        clone.style.margin = "0";
        if (clone.id) clone.id = clone.id + '-clone';

        Array.from(w.classList).forEach(cls => {
            if (cls.startsWith('page-scope-') && !clone.classList.contains(cls)) {
                clone.classList.add(cls);
            }
        });

        const cvs = document.createElement('canvas');
        cvs.className = 'draw-layer';
        cvs.width = 1000;
        cvs.height = 1414;
        cvs.style.width = '100%';
        cvs.style.height = '100%';
        cvs.style.position = 'absolute';
        cvs.style.top = '0';
        cvs.style.left = '0';
        cvs.style.zIndex = '999';
        cvs.style.pointerEvents = isDrawingMode ? 'auto' : 'none';
        cvs.style.touchAction = 'none';
        setupCanvasDrawing(cvs);
        clone.appendChild(cvs);

        fbElement.appendChild(clone);
    });

    const isPortrait = isPortraitMode();
    if (scaleWrapper) {
        scaleWrapper.style.width = (isPortrait ? 500 : 1000) + 'px';
        scaleWrapper.style.height = '707px';
    }

    pageFlip = new St.PageFlip(fbElement, {
        width: 500,
        height: 707,
        size: "fixed",
        minWidth: 300,
        maxWidth: 1000,
        minHeight: 400,
        maxHeight: 1000,
        maxShadowOpacity: 0.5,
        showCover: true,
        mobileScrollSupport: false,
        useMouseEvents: false,
        usePortrait: true
    });

    pageFlip.loadFromHTML(Array.from(fbElement.children));

    if (window.MathJax && window.MathJax.typesetPromise) {
        window.MathJax.typesetPromise([fbElement]).catch(() => {});
    }

    // Update total page count display dynamically based on actual pages loaded
    const actualPageCount = pageFlip.getPageCount();
    const totalNumEl = document.getElementById('total-page-num');
    if (totalNumEl && actualPageCount > 0) {
        totalNumEl.textContent = actualPageCount;
    }
    const jumpInput = document.getElementById('page-jump-input');
    if (jumpInput && actualPageCount > 0) {
        jumpInput.max = actualPageCount;
        jumpInput.placeholder = '1~' + actualPageCount;
    }

    pageFlip.on('flip', (e) => {
        const pageNum = e.data + 1;
        const pStatusEl = document.getElementById('page-status-text');
        if (pStatusEl) {
            pStatusEl.textContent = String(pageNum).padStart(2, '0');
        }
        const pNumEl = document.getElementById('current-page-num');
        if (pNumEl) {
            pNumEl.textContent = pageNum;
        }
    });
    
    pageFlip.on('changeOrientation', () => {
        resizeFlipbook();
    });
}

function setupViewerEvents() {
    const fbContainer = document.getElementById('flipbook-container');
    const scaleWrapper = document.getElementById('scale-wrapper');
    if (!fbContainer || !scaleWrapper) return;

    let touchMode = null;
    let touchStartTime = 0;
    let startTouchX = 0, startTouchY = 0;
    let startPanX = 0, startPanY = 0;
    let initialPinchDist = 0;
    let zoomAtPinchStart = 1;

    function getDistance(t1, t2) {
        const dx = t1.clientX - t2.clientX;
        const dy = t1.clientY - t2.clientY;
        return Math.hypot(dx, dy);
    }

    fbContainer.addEventListener('touchstart', (e) => {
        if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav, #drawing-toolbar')) {
            return;
        }

        touchStartTime = Date.now();

        if (e.touches.length === 2) {
            touchMode = 'pinch';
            initialPinchDist = getDistance(e.touches[0], e.touches[1]);
            zoomAtPinchStart = currentZoom;
            if (e.cancelable) e.preventDefault();
        } else if (e.touches.length === 1) {
            touchMode = 'single';
            startTouchX = e.touches[0].clientX;
            startTouchY = e.touches[0].clientY;
            startPanX = panX;
            startPanY = panY;
        }
    }, { passive: false });

    fbContainer.addEventListener('touchmove', (e) => {
        if (e.touches.length === 2 && touchMode === 'pinch') {
            if (e.cancelable) e.preventDefault();
            const currentDist = getDistance(e.touches[0], e.touches[1]);
            if (initialPinchDist > 0) {
                const ratio = currentDist / initialPinchDist;
                currentZoom = Math.min(Math.max(zoomAtPinchStart * ratio, 0.6), 3.5);
                resizeFlipbook();
            }
        } else if (e.touches.length === 1 && touchMode === 'single') {
            const moveX = e.touches[0].clientX - startTouchX;
            const moveY = e.touches[0].clientY - startTouchY;
            const dist = Math.hypot(moveX, moveY);

            if (currentZoom > 1.1) {
                if (e.cancelable) e.preventDefault();
                panX = startPanX + moveX;
                panY = startPanY + moveY;
                resizeFlipbook();
            } else if (dist > 15) {
                if (e.cancelable) e.preventDefault();
            }
        }
    }, { passive: false });

    fbContainer.addEventListener('touchend', (e) => {
        const touchDuration = Date.now() - touchStartTime;

        if (touchMode === 'single' && e.changedTouches.length === 1) {
            const endX = e.changedTouches[0].clientX;
            const endY = e.changedTouches[0].clientY;
            const moveX = endX - startTouchX;
            const moveY = endY - startTouchY;
            const dist = Math.hypot(moveX, moveY);

            // 1. Swipe Navigation
            if (currentZoom <= 1.1 && dist > 35 && pageFlip) {
                lastTouchEndTime = Date.now();
                if (pageFlip.getState && pageFlip.getState() !== 'read') return;
                if (moveX < -30) {
                    pageFlip.flipNext();
                    touchMode = null;
                    return;
                } else if (moveX > 30) {
                    pageFlip.flipPrev();
                    touchMode = null;
                    return;
                }
            }

            // 2. Tap Click Navigation
            if (dist < 15 && touchDuration < 400 && pageFlip && !isDrawingMode) {
                const target = document.elementFromPoint(endX, endY);
                if (target && target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav, #drawing-toolbar')) {
                    touchMode = null;
                    return;
                }

                if (e.cancelable) e.preventDefault();
                lastTouchEndTime = Date.now();
                if (pageFlip.getState && pageFlip.getState() !== 'read') return;

                const rect = scaleWrapper.getBoundingClientRect();
                const currIdx = pageFlip.getCurrentPageIndex();

                if (currIdx === 0 && !isPortraitMode()) {
                    pageFlip.flipNext();
                } else {
                    const relativeX = endX - rect.left;
                    if (relativeX < rect.width / 2) {
                        pageFlip.flipPrev();
                    } else {
                        pageFlip.flipNext();
                    }
                }
            }
        }
        touchMode = null;
    });

    let isMouseDown = false, mouseStartX = 0, mouseStartY = 0, mouseStartPanX = 0, mouseStartPanY = 0, isMouseDrag = false;

    scaleWrapper.addEventListener('mousedown', (e) => {
        if (Date.now() - lastTouchEndTime < 500) return;
        if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav, #drawing-toolbar')) {
            return;
        }
        isMouseDown = true;
        isMouseDrag = false;
        mouseStartX = e.clientX;
        mouseStartY = e.clientY;
        mouseStartPanX = panX;
        mouseStartPanY = panY;
    });

    window.addEventListener('mousemove', (e) => {
        if (!isMouseDown) return;
        const moveX = e.clientX - mouseStartX;
        const moveY = e.clientY - mouseStartY;

        if (Math.hypot(moveX, moveY) > 5) {
            isMouseDrag = true;
            if (currentZoom > 1.1) {
                panX = mouseStartPanX + moveX;
                panY = mouseStartPanY + moveY;
                resizeFlipbook();
            }
        }
    });

    window.addEventListener('mouseup', (e) => {
        if (Date.now() - lastTouchEndTime < 500) {
            isMouseDown = false;
            return;
        }
        if (isMouseDown && !isMouseDrag && pageFlip && !isDrawingMode) {
            if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav, #drawing-toolbar')) {
                isMouseDown = false;
                return;
            }
            if (pageFlip.getState && pageFlip.getState() !== 'read') {
                isMouseDown = false;
                return;
            }
            const rect = scaleWrapper.getBoundingClientRect();
            const currIdx = pageFlip.getCurrentPageIndex();

            if (currIdx === 0 && !isPortraitMode()) {
                pageFlip.flipNext();
            } else {
                const relativeX = e.clientX - rect.left;
                if (relativeX < rect.width / 2) {
                    pageFlip.flipPrev();
                } else {
                    pageFlip.flipNext();
                }
            }
        }
        isMouseDown = false;
    });

    window.addEventListener('resize', resizeFlipbook);
    window.addEventListener('orientationchange', resizeFlipbook);

    window.addEventListener('keydown', (e) => {
        if (!pageFlip) return;
        if (pageFlip.getState && pageFlip.getState() !== 'read') return;
        if (e.key === 'ArrowLeft' || e.key === 'PageUp') pageFlip.flipPrev();
        else if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') pageFlip.flipNext();
    });
}

window.toggleFlipbook = function() {
    const fbContainer = document.getElementById('flipbook-container');
    if (!fbContainer) return;

    fbContainer.style.display = "flex";
    document.body.style.display = "block";
    document.body.style.overflow = "hidden";

    if (!pageFlip) {
        initFlipbookEngine();
        setupViewerEvents();
    } else {
        if (window.MathJax && window.MathJax.typesetPromise) {
            const fb = document.getElementById('flipbook');
            if (fb) window.MathJax.typesetPromise([fb]).catch(() => {});
        }
    }

    currentZoom = 1.0;
    panX = 0;
    panY = 0;
    resizeFlipbook();
};

document.addEventListener('DOMContentLoaded', () => {
    window.toggleFlipbook();
});
</script>


</body>
</html>
