<!-- Direct Page Jump Popover -->
<div id="page-jump-popover" style="display: none; position: fixed; top: 55px; right: 20px; background: #0f172a; border: 1px solid #38bdf8; padding: 10px 14px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); z-index: 10002; gap: 8px; align-items: center;">
    <span style="color: #94a3b8; font-size: 12px; font-weight: bold;">페이지:</span>
