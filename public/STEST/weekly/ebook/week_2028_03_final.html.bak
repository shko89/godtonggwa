<div class="page-wrapper page-scope-page12" style="margin-top: 40px; display: flex; justify-content: center;">
<div class="a4-page" style="margin-top: 20px !important;">
    <div class="concept-spread">
        <div class="concept-page page-right">

            <!-- [자료 3] 핵산 (DNA vs RNA) -->
            <div class="info-box" style="flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div class="info-box-title">■ [자료 3] 핵산의 구조와 DNA, RNA 비교</div>
                    
                    <div class="sub-box" style="margin-top: 0; margin-bottom: 12px; background-color: #f8fafc;">
                        <ul class="bullet-list">
                            <li><b>핵산:</b> 유전 정보를 저장하거나 전달하고 단백질 합성에 관여하는 거대 분자. (단위체: 뉴클레오타이드)</li>
                        </ul>
                    </div>

                    <!-- TOP SECTION OF DATA 3: 2 SIDE-BY-SIDE CARDS -->
