                                <circle cx="50" cy="102" r="2.4" fill="url(#e-blue-dot)"/><text x="50" y="102.4" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="90" cy="102" r="2.4" fill="url(#e-blue-dot)"/><text x="90" y="102.4" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="95" cy="102" r="2.4" fill="url(#e-blue-dot)"/><text x="95" y="102.4" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>

                                <circle cx="25" cy="39.5" r="2.4" fill="url(#e-blue-dot)"/><text x="25" y="39.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="25" cy="44.5" r="2.4" fill="url(#e-blue-dot)"/><text x="25" y="44.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="115" cy="39.5" r="2.4" fill="url(#e-blue-dot)"/><text x="115" y="39.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="115" cy="44.5" r="2.4" fill="url(#e-blue-dot)"/><text x="115" y="44.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>

                                <circle cx="25" cy="79.5" r="2.4" fill="url(#e-blue-dot)"/><text x="25" y="79.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="25" cy="84.5" r="2.4" fill="url(#e-blue-dot)"/><text x="25" y="84.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="115" cy="79.5" r="2.4" fill="url(#e-blue-dot)"/><text x="115" y="79.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="115" cy="84.5" r="2.4" fill="url(#e-blue-dot)"/><text x="115" y="84.9" font-size="4" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>

