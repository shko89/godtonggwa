                            <stop offset="50%" stop-color="#dc2626"/>
                            <stop offset="100%" stop-color="#881337"/>
                        </radialGradient>
                        
<g id="tet-unit">
    <polygon points="0,-8 -7,4 0,0" fill="#0284c7" fill-opacity="0.65" />
    <polygon points="0,-8 7,4 0,0" fill="#7dd3fc" fill-opacity="0.45" />
    <polygon points="-7,4 7,4 0,0" fill="#38bdf8" fill-opacity="0.55" />

    <polygon points="0,-8 -7,4 7,4" fill="none" stroke="#0369a1" stroke-width="0.8"/>
    <line x1="0" y1="0" x2="0" y2="-8" stroke="#0369a1" stroke-width="0.7"/>
    <line x1="0" y1="0" x2="-7" y2="4" stroke="#0369a1" stroke-width="0.7"/>
    <line x1="0" y1="0" x2="7" y2="4" stroke="#0369a1" stroke-width="0.7"/>

    <circle cx="0" cy="-8" r="1.6" fill="url(#rg-common)"/>
    <circle cx="-7" cy="4" r="1.6" fill="url(#rg-common)"/>
    <circle cx="7" cy="4" r="1.6" fill="url(#rg-common)"/>
    <circle cx="0" cy="0" r="1.6" fill="url(#rg-common)"/>
</g>

                    </defs>
