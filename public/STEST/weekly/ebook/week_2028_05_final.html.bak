<!-- Master Flipbook Engine Script -->
<script>
// ==========================================
// 1. Close Button Logic
// ==========================================
window.closeViewer = function() {
    try {
        if (window.history.length > 1 && document.referrer) {
            window.history.back();
        } else {
            window.location.href = '../../exam.html';
        }
    } catch(e) {
        window.location.href = '../../exam.html';
    }
};

// ==========================================
// 2. TOC Navigation & Page Jump Popover
// ==========================================
window.toggleTocDrawer = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    const drawer = document.getElementById('toc-drawer');
    const overlay = document.getElementById('toc-overlay');
    if (!drawer || !overlay) return;

    const isOpen = drawer.style.transform === 'translateX(0px)';
    if (isOpen) {
        window.closeTocDrawer();
    } else {
        overlay.style.display = 'block';
        setTimeout(() => {
            overlay.style.opacity = '1';
            drawer.style.transform = 'translateX(0px)';
        }, 10);
    }
};

window.closeTocDrawer = function() {
    const drawer = document.getElementById('toc-drawer');
    const overlay = document.getElementById('toc-overlay');
    if (!drawer || !overlay) return;

    drawer.style.transform = 'translateX(-100%)';
    overlay.style.opacity = '0';
    setTimeout(() => {
        overlay.style.display = 'none';
    }, 250);
};

window.goToPage = function(targetPageNum) {
    window.closeTocDrawer();
    if (pageFlip) {
        const targetIdx = targetPageNum - 1;
        if (targetIdx >= 0 && targetIdx < pageFlip.getPageCount()) {
            pageFlip.flip(targetIdx);
        }
    }
};

window.togglePageJumpModal = function(e) {
    if (e) {
        try { e.stopPropagation(); } catch(err){}
    }
    const popover = document.getElementById('page-jump-popover');
    if (!popover) return;
    const isShowing = popover.style.display === 'flex';
    if (isShowing) {
        popover.style.display = 'none';
    } else {
        popover.style.display = 'flex';
        const input = document.getElementById('page-jump-input');
        if (input) {
            input.value = pageFlip ? (pageFlip.getCurrentPageIndex() + 1) : 1;
            setTimeout(() => input.focus(), 50);
        }
    }
};

window.submitPageJump = function() {
    const input = document.getElementById('page-jump-input');
    const popover = document.getElementById('page-jump-popover');
    if (!input || !pageFlip) return;
    const val = parseInt(input.value, 10);
    const max = pageFlip.getPageCount();
    if (!isNaN(val) && val >= 1 && val <= max) {
        pageFlip.flip(val - 1);
        if (popover) popover.style.display = 'none';
    } else {
        alert('1부터 ' + max + ' 사이의 페이지 번호를 입력해주세요.');
    }
};

document.addEventListener('click', (e) => {
    const popover = document.getElementById('page-jump-popover');
    const pill = document.getElementById('page-jump-pill');
    if (popover && popover.style.display === 'flex') {
        if (!popover.contains(e.target) && !pill.contains(e.target)) {
            popover.style.display = 'none';
        }
    }
});

// ==========================================
// 3. Drawing Tools (Pen, Highlighter, Eraser)
// ==========================================
let isDrawingMode = false;
let currentPenColor = '#0f172a';
let isHighlighter = false;

window.toggleDrawingMode = function(e) {
    if (e) try { e.stopPropagation(); } catch(err){}
    isDrawingMode = !isDrawingMode;
    const btn = document.getElementById('btn-mode-toggle');
    const tools = document.getElementById('drawing-tools');
    if (isDrawingMode) {
        btn.textContent = '✏️ 그리기 중';
        btn.style.background = '#f43f5e';
        btn.style.color = '#ffffff';
        tools.style.display = 'flex';
    } else {
        btn.textContent = '📖 보기 모드';
        btn.style.background = '#38bdf8';
        btn.style.color = '#0f172a';
        tools.style.display = 'none';
    }
    document.querySelectorAll('.page-canvas').forEach(cvs => {
        cvs.style.pointerEvents = isDrawingMode ? 'auto' : 'none';
    });
};

window.setPen = function(color, btn, isHl = false, e = null) {
    if (e) try { e.stopPropagation(); } catch(err){}
    currentPenColor = color;
    isHighlighter = isHl;
    document.querySelectorAll('.pen-btn').forEach(b => {
        b.style.borderColor = 'transparent';
    });
    if (btn) btn.style.borderColor = '#ffffff';
};

window.setEraser = function(btn, e = null) {
    if (e) try { e.stopPropagation(); } catch(err){}
    currentPenColor = 'eraser';
    isHighlighter = false;
    document.querySelectorAll('.pen-btn').forEach(b => {
        b.style.borderColor = 'transparent';
    });
};

window.clearAllCanvas = function(e = null) {
    if (e) try { e.stopPropagation(); } catch(err){}
    if (confirm('현재 페이지의 필기를 모두 지우시겠습니까?')) {
        document.querySelectorAll('.page-canvas').forEach(cvs => {
            const ctx = cvs.getContext('2d');
            ctx.clearRect(0, 0, cvs.width, cvs.height);
        });
    }
};

function setupCanvasDrawing(canvas) {
    const ctx = canvas.getContext('2d');
    let isDrawing = false;
    let lastX = 0, lastY = 0;

    function getCanvasCoords(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        return {
            x: (clientX - rect.left) * scaleX,
            y: (clientY - rect.top) * scaleY
        };
    }

    canvas.addEventListener('pointerdown', (e) => {
        if (!isDrawingMode) return;
        e.stopPropagation();
        if (e.cancelable) e.preventDefault();
        isDrawing = true;
        try { if (canvas.setPointerCapture) canvas.setPointerCapture(e.pointerId); } catch(err){}

        const pos = getCanvasCoords(e.clientX, e.clientY);
        lastX = pos.x;
        lastY = pos.y;
    });

    canvas.addEventListener('pointermove', (e) => {
        if (!isDrawing || !isDrawingMode) return;
        e.stopPropagation();
        if (e.cancelable) e.preventDefault();

        const pos = getCanvasCoords(e.clientX, e.clientY);
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(pos.x, pos.y);

        if (currentPenColor === 'eraser') {
            ctx.globalCompositeOperation = 'destination-out';
            ctx.lineWidth = 20;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke();
        } else if (isHighlighter) {
            ctx.globalCompositeOperation = 'source-over';
            ctx.strokeStyle = currentPenColor;
            ctx.lineWidth = 14;
            ctx.lineCap = 'square';
            ctx.lineJoin = 'round';
            ctx.stroke();
        } else {
            ctx.globalCompositeOperation = 'source-over';
            ctx.strokeStyle = currentPenColor;
            ctx.lineWidth = 2.5;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke();
        }

        lastX = pos.x;
        lastY = pos.y;
    });

    canvas.addEventListener('pointerup', (e) => {
        if (!isDrawing) return;
        isDrawing = false;
        try { if (canvas.releasePointerCapture) canvas.releasePointerCapture(e.pointerId); } catch(err){}
    });

    canvas.addEventListener('pointercancel', (e) => {
        isDrawing = false;
    });
}

// ==========================================
// 4. St.PageFlip Viewer & Touch System
// ==========================================
let pageFlip = null;
let currentZoom = 1.0;
let panX = 0;
let panY = 0;
let lastTouchEndTime = 0;

function isPortraitMode() {
    return window.innerWidth < window.innerHeight;
}

function resizeFlipbook() {
    const fbContainer = document.getElementById('flipbook-container');
    const scaleWrapper = document.getElementById('scale-wrapper');
    if (!fbContainer || !scaleWrapper) return;

    const winW = fbContainer.clientWidth || window.innerWidth;
    const winH = fbContainer.clientHeight || window.innerHeight;
    
    const isPortrait = isPortraitMode();
    const targetW = isPortrait ? 500 : 1000;
    const targetH = 707;

    scaleWrapper.style.width = targetW + 'px';
    scaleWrapper.style.height = targetH + 'px';

    if (currentZoom <= 1.05) {
        panX = 0;
        panY = 0;
    }

    const scaleX = (winW - 10) / targetW;
    const scaleY = (winH - 10) / targetH;
    let baseScale = Math.min(scaleX, scaleY);

    let totalScale = baseScale * currentZoom;
    scaleWrapper.style.transform = 'translate(calc(-50% + ' + panX + 'px), calc(-50% + ' + panY + 'px)) scale(' + totalScale + ')';
}

window.addEventListener('resize', () => {
    resizeFlipbook();
});

function zoomFlipbook(delta) {
    currentZoom = Math.min(Math.max(currentZoom + delta, 1.0), 3.0);
    if (currentZoom <= 1.05) {
        panX = 0;
        panY = 0;
    }
    resizeFlipbook();
}

function resetZoom() {
    currentZoom = 1.0;
    panX = 0;
    panY = 0;
    resizeFlipbook();
}

function initFlipbookEngine() {
    const fbElement = document.getElementById('flipbook');
    const scaleWrapper = document.getElementById('scale-wrapper');
    const mc = document.getElementById('main-content');
    if (!fbElement || pageFlip || !mc) return;

    const topWrappers = Array.from(mc.querySelectorAll('.page-wrapper'));
    fbElement.innerHTML = '';

    topWrappers.forEach(w => {
        const a4Page = w.querySelector('.a4-page, .concept-page, .spread-page') || w.firstElementChild;
        if (!a4Page) return;
        if (a4Page.classList.contains('concept-spread') && !a4Page.querySelector('.concept-page')) return;

        const clone = a4Page.cloneNode(true);
        const wScopeClass = Array.from(w.classList).find(c => c.startsWith('page-scope-'));
        if (wScopeClass) {
            clone.classList.add(wScopeClass);
        }

        // Attach drawing canvas
        const cvs = document.createElement('canvas');
        cvs.className = 'page-canvas';
        cvs.width = 500;
        cvs.height = 707;
        cvs.style.position = 'absolute';
        cvs.style.top = '0';
        cvs.style.left = '0';
        cvs.style.width = '500px';
        cvs.style.height = '707px';
        cvs.style.zIndex = '999';
        cvs.style.pointerEvents = isDrawingMode ? 'auto' : 'none';
        cvs.style.touchAction = 'none';
        setupCanvasDrawing(cvs);
        clone.appendChild(cvs);

        fbElement.appendChild(clone);
    });

    pageFlip = new St.PageFlip(fbElement, {
        width: 500,
        height: 707,
        size: 'fixed',
        minWidth: 300,
        maxWidth: 1000,
        minHeight: 424,
        maxHeight: 1414,
        maxShadowOpacity: 0.25,
        showCover: true,
        mobileScrollSupport: false,
        useMouseEvents: false,
        flippingTime: 450,
        disableFlipByClick: true
    });

    pageFlip.loadFromHTML(Array.from(fbElement.children));

    if (window.MathJax && window.MathJax.typesetPromise) {
        window.MathJax.typesetPromise([fbElement]).catch(() => {});
    }
    
    const actualPageCount = pageFlip.getPageCount();
    const totalNumEl = document.getElementById('total-page-num');
    if (totalNumEl && actualPageCount > 0) {
        totalNumEl.textContent = actualPageCount;
    }
    const jumpInput = document.getElementById('page-jump-input');
    if (jumpInput && actualPageCount > 0) {
        jumpInput.max = actualPageCount;
        jumpInput.placeholder = '1~' + actualPageCount;
    }

    pageFlip.on('flip', (e) => {
        const pageNum = e.data + 1;
        const pNumEl = document.getElementById('current-page-num');
        if (pNumEl) {
            pNumEl.textContent = pageNum;
        }
    });

    resizeFlipbook();
}

function setupViewerEvents() {
    const fbContainer = document.getElementById('flipbook-container');
    const scaleWrapper = document.getElementById('scale-wrapper');
    if (!fbContainer || !scaleWrapper) return;

    let touchMode = null;
    let touchStartX = 0, touchStartY = 0;
    let initialPinchDist = 0;
    let initialZoom = 1.0;
    let touchStartTime = 0;

    let isMouseDown = false;
    let isMouseDrag = false;
    let mouseStartX = 0, mouseStartY = 0;

    fbContainer.addEventListener('touchstart', (e) => {
        if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav')) {
            return;
        }
        if (e.touches.length === 2) {
            touchMode = 'pinch';
            initialPinchDist = Math.hypot(
                e.touches[0].clientX - e.touches[1].clientX,
                e.touches[0].clientY - e.touches[1].clientY
            );
            initialZoom = currentZoom;
        } else if (e.touches.length === 1) {
            touchMode = 'swipe';
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            touchStartTime = Date.now();
        }
    }, { passive: true });

    fbContainer.addEventListener('touchmove', (e) => {
        if (!touchMode) return;

        if (touchMode === 'pinch' && e.touches.length === 2) {
            if (e.cancelable) e.preventDefault();
            const dist = Math.hypot(
                e.touches[0].clientX - e.touches[1].clientX,
                e.touches[0].clientY - e.touches[1].clientY
            );
            const factor = dist / initialPinchDist;
            currentZoom = Math.min(Math.max(initialZoom * factor, 1.0), 3.0);
            resizeFlipbook();
        } else if (touchMode === 'swipe' && e.touches.length === 1) {
            const moveX = e.touches[0].clientX - touchStartX;
            const moveY = e.touches[0].clientY - touchStartY;

            if (currentZoom > 1.05) {
                if (e.cancelable) e.preventDefault();
                panX += moveX * 0.7;
                panY += moveY * 0.7;
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                resizeFlipbook();
            }
        }
    }, { passive: false });

    fbContainer.addEventListener('touchend', (e) => {
        if (!touchMode) return;

        if (touchMode === 'swipe') {
            const endX = e.changedTouches[0].clientX;
            const endY = e.changedTouches[0].clientY;
            const moveX = endX - touchStartX;
            const moveY = endY - touchStartY;
            const dist = Math.hypot(moveX, moveY);
            const touchDuration = Date.now() - touchStartTime;

            if (currentZoom <= 1.1 && dist > 35 && pageFlip) {
                lastTouchEndTime = Date.now();
                if (pageFlip.getState && pageFlip.getState() !== 'read') return;
                if (moveX < -30) {
                    pageFlip.flipNext();
                } else if (moveX > 30) {
                    pageFlip.flipPrev();
                }
            }

            if (dist < 15 && touchDuration < 400 && pageFlip && !isDrawingMode) {
                const target = document.elementFromPoint(endX, endY);
                if (target && target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav')) {
                    touchMode = null;
                    return;
                }

                if (e.cancelable) e.preventDefault();
                lastTouchEndTime = Date.now();
                if (pageFlip.getState && pageFlip.getState() !== 'read') return;

                const rect = scaleWrapper.getBoundingClientRect();
                const currIdx = pageFlip.getCurrentPageIndex();

                if (currIdx === 0 && !isPortraitMode()) {
                    pageFlip.flipNext();
                } else {
                    if (endX < rect.left + rect.width / 2) {
                        pageFlip.flipPrev();
                    } else {
                        pageFlip.flipNext();
                    }
                }
            }
        }

        touchMode = null;
    }, { passive: false });

    scaleWrapper.addEventListener('mousedown', (e) => {
        if (Date.now() - lastTouchEndTime < 500) return;
        if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav')) {
            return;
        }
        if (isDrawingMode) return;

        isMouseDown = true;
        isMouseDrag = false;
        mouseStartX = e.clientX;
        mouseStartY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
        if (!isMouseDown) return;
        const moveX = e.clientX - mouseStartX;
        const moveY = e.clientY - mouseStartY;

        if (Math.hypot(moveX, moveY) > 5) {
            isMouseDrag = true;
        }

        if (currentZoom > 1.05 && isMouseDrag) {
            panX += moveX * 0.7;
            panY += moveY * 0.7;
            mouseStartX = e.clientX;
            mouseStartY = e.clientY;
            resizeFlipbook();
        }
    });

    window.addEventListener('mouseup', (e) => {
        if (Date.now() - lastTouchEndTime < 500) {
            isMouseDown = false;
            return;
        }
        if (isMouseDown && !isMouseDrag && pageFlip && !isDrawingMode) {
            if (e.target.closest('.ox-btn, .blank, button, input, select, textarea, a, .zoom-btn, #close-flipbook-btn, #drawing-tools, #top-nav')) {
                isMouseDown = false;
                return;
            }
            if (pageFlip.getState && pageFlip.getState() !== 'read') {
                isMouseDown = false;
                return;
            }

            const rect = scaleWrapper.getBoundingClientRect();
            const currIdx = pageFlip.getCurrentPageIndex();

            if (currIdx === 0 && !isPortraitMode()) {
                pageFlip.flipNext();
            } else {
                if (e.clientX < rect.left + rect.width / 2) {
                    pageFlip.flipPrev();
                } else {
                    pageFlip.flipNext();
                }
            }
        }
        isMouseDown = false;
        isMouseDrag = false;
    });

    window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (!pageFlip) return;
        if (pageFlip.getState && pageFlip.getState() !== 'read') return;

        if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
            pageFlip.flipNext();
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
            pageFlip.flipPrev();
        } else if (e.key === 'Home') {
            pageFlip.flip(0);
        } else if (e.key === 'End') {
            pageFlip.flip(pageFlip.getPageCount() - 1);
        }
    });
}

window.toggleFlipbook = function() {
    const fbContainer = document.getElementById('flipbook-container');
    const mainContent = document.getElementById('main-content');
    if (!fbContainer || !mainContent) return;

    fbContainer.style.display = 'flex';
    mainContent.style.display = 'none';

    if (!pageFlip) {
        initFlipbookEngine();
        setupViewerEvents();
    } else {
        if (window.MathJax && window.MathJax.typesetPromise) {
            const fb = document.getElementById('flipbook');
            if (fb) window.MathJax.typesetPromise([fb]).catch(() => {});
        }
    }
};

document.addEventListener('DOMContentLoaded', () => {
    window.toggleFlipbook();
});
</script>

</body>
</html>
