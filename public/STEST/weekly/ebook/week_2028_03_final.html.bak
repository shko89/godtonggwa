                                        <use href="#tet-unit" transform="translate(79, 66) rotate(180)"/>
                                    </g>
                                </svg>
                                <div class="struct-card-sub"><b>공유 3개</b><br>Si:O = 2:5<br><span style="color:#b91c1c; font-weight:bold;">흑운모</span></div>
                            </div>

                            <!-- 5. 망상 구조 (입체감을 강조한 이중 레이어 3D Framework) -->
                            <div class="struct-card">
