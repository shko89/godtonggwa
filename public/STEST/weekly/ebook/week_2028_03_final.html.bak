                <!-- [자료 2] 규산염 광물의 단위체 및 다양한 결합 구조 -->
                <div class="info-box">
                    <div class="info-box-title">■ [자료 2] 규산염 광물의 단위체 및 다양한 결합 구조 모형</div>
                    <div class="content-box" style="padding: 4px;">
                        
                        <!-- 1. Si-O 사면체의 구조 -->
                        <div style="display: flex; align-items: center; justify-content: space-around; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; padding: 3px; margin-bottom: 3px;">
                            <svg width="150" height="68" viewBox="0 0 150 68">
                                <defs>
                                    <radialGradient id="o-red-grad" cx="35%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#fda4af" />
                                        <stop offset="40%" stop-color="#f43f5e" />
                                        <stop offset="100%" stop-color="#9f1239" />
                                    </radialGradient>
                                    <radialGradient id="si-dark-grad" cx="35%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#64748b" />
                                        <stop offset="50%" stop-color="#1e293b" />
                                        <stop offset="100%" stop-color="#020617" />
                                    </radialGradient>
                                </defs>

                                <polygon points="75,10 30,48 120,44" fill="#bae6fd" fill-opacity="0.45" stroke="#7dd3fc" stroke-width="1"/>
                                <polygon points="75,10 30,48 75,60" fill="#7dd3fc" fill-opacity="0.45" stroke="#38bdf8" stroke-width="1"/>
                                <polygon points="75,10 120,44 75,60" fill="#38bdf8" fill-opacity="0.35" stroke="#0284c7" stroke-width="1"/>

                                <line x1="75" y1="33" x2="75" y2="10" stroke="#475569" stroke-width="2.2" stroke-linecap="round"/>
                                <line x1="75" y1="33" x2="30" y2="48" stroke="#475569" stroke-width="2.2" stroke-linecap="round"/>
                                <line x1="75" y1="33" x2="120" y2="44" stroke="#475569" stroke-width="2.2" stroke-linecap="round"/>
                                <line x1="75" y1="33" x2="75" y2="60" stroke="#475569" stroke-width="2.2" stroke-linecap="round"/>

                                <circle cx="75" cy="33" r="7" fill="url(#si-dark-grad)"/>
                                <text x="75" y="33.5" font-size="6" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">Si</text>

                                <circle cx="75" cy="10" r="9" fill="url(#o-red-grad)"/>
                                <text x="75" y="10.5" font-size="7.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">O</text>

                                <circle cx="30" cy="48" r="9" fill="url(#o-red-grad)"/>
                                <text x="30" y="48.5" font-size="7.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">O</text>

                                <circle cx="120" cy="44" r="9" fill="url(#o-red-grad)"/>
                                <text x="120" y="44.5" font-size="7.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">O</text>

                                <circle cx="75" cy="60" r="9" fill="url(#o-red-grad)"/>
                                <text x="75" y="60.5" font-size="7.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">O</text>
                            </svg>

                            <div style="font-size: 8px; color: #334155; line-height: 1.35; text-align: left;">
                                <div style="font-size: 9px; font-weight: 900; color: #0284c7; margin-bottom: 2px;">Si－O 사면체의 구조</div>
                                • <b>중심:</b> 규소 원자(Si) 1개 (+4 전하)<br>
                                • <b>꼭짓점:</b> 산소 원자(O) 4개 (-2 전하)<br>
                                • <b>전하:</b> 전체적으로 <span style="color:#dc2626; font-weight:bold;">-4의 음전하</span>를 띰 (SiO₄⁴⁻).
                            </div>
                        </div>

                        <!-- 2. SVG Models for 5 Silicate Polymerization Structures USING 100% REUSABLE SYMBOLS -->
                        <div class="struct-grid">
                            
                            <!-- 1. 독립형 구조 -->
                            <div class="struct-card">
                                <div class="struct-card-title">독립형 구조</div>
                                <svg width="86" height="52" viewBox="0 0 86 52">
                                    <g transform="translate(3, 2)">
                                        <use href="#tet-unit" transform="translate(10, 10)"/>
                                        <use href="#tet-unit" transform="translate(28, 14) rotate(180)"/>
                                        <use href="#tet-unit" transform="translate(46, 10)"/>
                                        <use href="#tet-unit" transform="translate(64, 14) rotate(180)"/>

