                                            <text x="50.5" y="16" font-size="4.8" font-weight="bold" fill="#312e81" text-anchor="middle">염기</text>
                                        </g>

                                        <!-- Explicit Covalent Bond line -->
                                        <line x1="11" y1="48" x2="21" y2="24" stroke="#dc2626" stroke-width="1.8"/>

                                        <!-- Curved Magenta Arrow from bottom phosphate to top sugar -->
                                        <path d="M 11 48 C 2 36, 6 24, 19 24" fill="none" stroke="#ec4899" stroke-width="1.8" marker-end="url(#magenta-arrow)"/>

                                        <!-- Encapsulating Oval Loop -->
                                        <rect x="4" y="2" width="56" height="68" rx="12" fill="none" stroke="#64748b" stroke-width="0.8" stroke-dasharray="2,2"/>

                                        <!-- Explanation Text below -->
                                        <text x="32" y="88" font-size="4.5" font-weight="bold" fill="#334155" text-anchor="middle">한 뉴클레오타이드의 인산이 다른</text>
