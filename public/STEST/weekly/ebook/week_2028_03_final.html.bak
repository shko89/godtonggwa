                    <!-- LOWER SECTION OF DATA 3: DETAILED DNA DOUBLE HELIX ZOOM & ZERO-GAP RNA -->
                    <div class="content-box" style="padding: 5px; margin-top: 14px; margin-bottom: 12px;">
                        <svg width="440" height="152" viewBox="0 0 440 152">
