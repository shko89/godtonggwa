                                <rect x="148" y="0" width="69" height="20" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                <text x="182.5" y="8" font-size="6.8" font-weight="bold" fill="#d97706" text-anchor="middle">3위 수소(H)</text>
                                <text x="182.5" y="16.5" font-size="7.2" font-weight="900" fill="#0f172a" text-anchor="middle">9.5%</text>

                                <rect x="222" y="0" width="73" height="20" rx="4" fill="#f8fafc" stroke="#cbd5e1"/>
                                <text x="258.5" y="8" font-size="6.8" font-weight="bold" fill="#475569" text-anchor="middle">4위 질소(N)</text>
                                <text x="258.5" y="16.5" font-size="7.2" font-weight="900" fill="#0f172a" text-anchor="middle">3.3%</text>
