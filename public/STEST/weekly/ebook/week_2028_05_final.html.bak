                            <!-- Driver & Safety Controls -->
                            <!-- Driver Body -->
                            <circle cx="172" cy="35" r="5.5" fill="#fde047" stroke="#854d0e" stroke-width="1.2"/>
                            <path d="M 172 40.5 L 172 56 L 184 64" fill="none" stroke="#1e293b" stroke-width="1.8"/>
                            <!-- Seatbelt (안전벨트) -->
                            <line x1="166" y1="30" x2="178" y2="58" stroke="#dc2626" stroke-width="2"/>
                            <!-- Deploying Airbag (에어백) -->
                            <ellipse cx="196" cy="42" rx="10" ry="12" fill="#fef08a" stroke="#ca8a04" stroke-width="1.3"/>
                            <text x="196" y="44.5" font-size="6" font-weight="900" fill="#854d0e" text-anchor="middle">에어백</text>

                            <!-- Top Badges & Annotations -->
                            <!-- 1. Crumple Zone Badge -->
                            <rect x="250" y="3" width="130" height="17" rx="3.5" fill="#ef4444"/>
                            <text x="315" y="14.5" font-size="7.2" font-weight="900" fill="#ffffff" text-anchor="middle">① 크럼플 존 : 차체 찌그러짐 (Δt ↑)</text>
                            <line x1="315" y1="20" x2="315" y2="30" stroke="#ef4444" stroke-width="1.2"/>

                            <!-- 2. Seatbelt Badge -->
                            <rect x="68" y="3" width="120" height="17" rx="3.5" fill="#0284c7"/>
