<div class="svg-container" style="flex: 1.25; height: 134px; min-height: 134px; max-height: 134px; width: 100%; display: flex; justify-content: center; align-items: center; text-align: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 4px; box-sizing: border-box; overflow: hidden;"><svg height="100%" preserveaspectratio="xMidYMid meet" style="display: block; margin: auto;" viewbox="0 0 240 135" width="100%">
