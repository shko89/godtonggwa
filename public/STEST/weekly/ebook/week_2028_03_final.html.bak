<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #cbd5e1; padding-bottom: 10px; margin-bottom: 20px;">
<!-- ... existing code ... -->
<div class="header-brand" style="font-family: 'Roboto'; font-weight: 900; font-size: 13px; letter-spacing: 2px; color: #94a3b8;">GOTONGGWA WEEKLY</div>
</div>
<div>
<h2 class="bridge-title">물질의 규칙성과 결합</h2>
<div class="bridge-sub">이온 결합과 공유 결합 ➔ 규산염 광물과 탄소 화합물 ➔ 반도체의 활용</div>
</div>
<br/>
<!-- gap 속성을 12px에서 36px로 크게 늘려 Q1, Q2, Q3 사이의 여백을 시원하게 만듭니다. -->
<div class="grid-container" style="grid-template-columns: 1fr; grid-auto-rows: minmax(100px, auto); gap: 36px;">
<!-- Q1 Quadrant -->
<div class="quadrant">
<div style="flex: 1;">
<div class="quadrant-header">
<div class="quadrant-title"><span class="quadrant-num">Q1.</span> 화학 결합의 원리</div>
<div class="quadrant-desc">이온 결합과 공유 결합의 생성 원리</div>
</div>
<div class="tutor-note" style="margin-top: 18px !important;">
<div class="tutor-badge">Tutor's Schema</div>
<p class="handwriting">"금속과 비금속이 만나면 전자를 주고받는 이온 결합, 비금속끼리 만나면 전자를 공유하는 공유 결합이 형성된다는 점이 핵심이야!"</p>
</div>
</div>
<!-- 여백을 위해 min-height를 115px로 늘리고, viewBox height도 늘려줍니다. -->
<div class="svg-container" style="flex: 1; min-height: 115px; display: flex; align-items: center; justify-content: center;">
<svg height="115" viewbox="0 0 250 115" width="250">
<!-- 상단 결합 구성 요소 텍스트 -->
<text fill="#0284c7" font-size="10" font-weight="900" text-anchor="middle" x="72.5" y="16">금속 + 비금속</text>
<text fill="#0284c7" font-size="10" font-weight="900" text-anchor="middle" x="185" y="16">비금속 + 비금속</text>
<!-- 이온 결합 -->
<circle cx="50" cy="55" fill="#fef2f2" r="18" stroke="#ef4444" stroke-width="2"></circle>
<text fill="#ef4444" font-size="15" font-weight="bold" text-anchor="middle" x="50" y="60">+</text>
<circle cx="95" cy="55" fill="#f0fdfa" r="18" stroke="#0ea5e9" stroke-width="2"></circle>
<text fill="#0ea5e9" font-size="15" font-weight="bold" text-anchor="middle" x="95" y="60">-</text>
<!-- 공유 결합 -->
<circle cx="170" cy="55" fill="none" r="18" stroke="#0ea5e9" stroke-width="2"></circle>
<circle cx="200" cy="55" fill="none" r="18" stroke="#0ea5e9" stroke-width="2"></circle>
<circle cx="185" cy="45.05" fill="#0ea5e9" r="4.5"></circle>
<circle cx="185" cy="64.95" fill="#0ea5e9" r="4.5"></circle>
<!-- 하단 결합 명칭 -->
<text fill="#64748b" font-size="11" font-weight="bold" text-anchor="middle" x="72.5" y="105">이온 결합</text>
<text fill="#64748b" font-size="11" font-weight="bold" text-anchor="middle" x="185" y="105">공유 결합</text>
</svg>
</div>
</div>
<!-- Q2 Quadrant -->
<div class="quadrant">
<div class="svg-container" style="flex: 1; min-height: 115px; display: flex; align-items: center; justify-content: center;">
<svg height="115" viewbox="0 0 250 115" width="250">
<defs>
<!-- 3D Spherical Radial Gradients -->
<radialgradient cx="35%" cy="35%" id="si-grad" r="65%">
<stop offset="0%" stop-color="#38bdf8"></stop>
<stop offset="60%" stop-color="#0284c7"></stop>
<stop offset="100%" stop-color="#0369a1"></stop>
</radialgradient>
<radialgradient cx="35%" cy="35%" id="o-grad" r="65%">
<stop offset="0%" stop-color="#fca5a5"></stop>
<stop offset="60%" stop-color="#ef4444"></stop>
<stop offset="100%" stop-color="#b91c1c"></stop>
</radialgradient>
<radialgradient cx="35%" cy="35%" id="c-grad" r="65%">
<stop offset="0%" stop-color="#94a3b8"></stop>
<stop offset="60%" stop-color="#475569"></stop>
<stop offset="100%" stop-color="#1e293b"></stop>
</radialgradient>
</defs>
<!-- 1. 입체적인 규산염 사면체 (Left) -->
<!-- Z-index(그리기 순서)를 뒤쪽 산소 -> 중심 규소 -> 앞쪽 산소 순으로 배치하여 완벽한 입체감을 줍니다. -->
<g transform="translate(10, 0)">
<!-- 1) 뒤쪽 점선 외곽선 -->
<line stroke="#cbd5e1" stroke-dasharray="3,3" stroke-width="1.5" x1="20" x2="90" y1="62" y2="62"></line>
<!-- 2) 뒤쪽 산소 결합선 (Si-O) -->
<line stroke="#38bdf8" stroke-width="3" x1="55" x2="20" y1="42" y2="62"></line>
<line stroke="#38bdf8" stroke-width="3" x1="55" x2="90" y1="42" y2="62"></line>
<!-- 3) 뒤쪽 산소 원자 (O) -->
<circle cx="20" cy="62" fill="url(#o-grad)" r="10" stroke="#ffffff" stroke-width="1.5"></circle>
<text fill="#ffffff" font-family="'Inter', sans-serif" font-size="10" font-weight="900" text-anchor="middle" x="20" y="65.5">O</text>
<circle cx="90" cy="62" fill="url(#o-grad)" r="10" stroke="#ffffff" stroke-width="1.5"></circle>
<text fill="#ffffff" font-family="'Inter', sans-serif" font-size="10" font-weight="900" text-anchor="middle" x="90" y="65.5">O</text>
<!-- 4) 나머지 사면체 뼈대 외곽선 -->
<line stroke="#cbd5e1" stroke-width="1.5" x1="55" x2="20" y1="12" y2="62"></line>
<line stroke="#cbd5e1" stroke-width="1.5" x1="55" x2="90" y1="12" y2="62"></line>
<line stroke="#cbd5e1" stroke-width="1.5" x1="20" x2="55" y1="62" y2="78"></line>
<line stroke="#cbd5e1" stroke-width="1.5" x1="90" x2="55" y1="62" y2="78"></line>
<!-- 5) 위쪽 산소 결합선 (Si-O) -->
<line stroke="#38bdf8" stroke-width="3" x1="55" x2="55" y1="42" y2="12"></line>
<!-- 6) 위쪽 산소 원자 (O) -->
<circle cx="55" cy="12" fill="url(#o-grad)" r="10" stroke="#ffffff" stroke-width="1.5"></circle>
<text fill="#ffffff" font-family="'Inter', sans-serif" font-size="10" font-weight="900" text-anchor="middle" x="55" y="15.5">O</text>
<!-- 7) 정중앙 규소 원자 (Si) -->
