                                        <path d="M -2 0 L -6 0" stroke="#f59e0b" stroke-width="1.2" marker-end="url(#arr-soft)"/>
                                    </g>
                                    <g transform="translate(50, 38)">
                                        <circle cx="0" cy="0" r="5" fill="#10b981"/>
                                        <text x="0" y="0.5" font-size="5.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">-</text>
                                        <path d="M 2 0 L 6 0" stroke="#10b981" stroke-width="1.2" marker-end="url(#arr-soft)"/>
                                    </g>
                                    
                                    <!-- Wires & Glowing Bulb -->
                                    <path d="M 29.5 10 L 29.5 0 L 115 0 L 115 10 L 62.5 10" fill="none" stroke="#0284c7" stroke-width="1.5"/>
                                    <circle cx="75" cy="0" r="9.5" fill="#fef08a" stroke="#eab308" stroke-width="1.5"/>
                                    <text x="75" y="0.5" font-size="8" font-weight="900" fill="#854d0e" text-anchor="middle" dominant-baseline="central">💡</text>
                                    
                                    <text x="120" y="34" font-size="10.5" font-weight="900" fill="#15803d">전류 흐름 (◯)</text>
                                    <text x="120" y="47" font-size="8.5" font-weight="bold" fill="#0369a1">전구 ON (이온 이동)</text>
                                </g>
                            </g>

                            <!-- 2. 공유 결합 물질 (설탕) - Height 124px -->
                            <g transform="translate(0, 132)">
                                <rect x="5" y="2" width="420" height="122" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.2"/>
                                <rect x="12" y="8" width="145" height="20" rx="4" fill="#f1f5f9"/>
                                <text x="84.5" y="21" font-size="10" font-weight="800" fill="#475569" text-anchor="middle">공유 결합 물질 (설탕)</text>

                                <!-- Densely Packed Touching Solid Sugar Molecules (4x4 Grid) -->
                                <g transform="translate(15, 34)">
                                    <rect x="0" y="0" width="52" height="52" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                                    <!-- Row 0 -->
                                    <ellipse cx="8.5" cy="8.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="19.5" cy="8.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="30.5" cy="8.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="41.5" cy="8.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>

                                    <!-- Row 1 -->
                                    <ellipse cx="8.5" cy="19.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="19.5" cy="19.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="30.5" cy="19.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="41.5" cy="19.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>

                                    <!-- Row 2 -->
                                    <ellipse cx="8.5" cy="30.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="19.5" cy="30.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="30.5" cy="30.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="41.5" cy="30.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>

                                    <!-- Row 3 -->
                                    <ellipse cx="8.5" cy="41.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="19.5" cy="41.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="30.5" cy="41.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="41.5" cy="41.5" rx="5" ry="4.5" fill="#0284c7" opacity="0.75"/>

                                    <text x="26" y="67" font-size="9" font-weight="bold" fill="#475569" text-anchor="middle">고체 (분자 결정)</text>
                                </g>

                                <!-- Arrow 1 -->
                                <path d="M 74 60 L 98 60" fill="none" stroke="#0284c7" stroke-width="1.8" marker-end="url(#arr-soft)"/>
                                <text x="86" y="52" font-size="8" font-weight="bold" fill="#0369a1" text-anchor="middle">물에 녹임</text>

                                <!-- Dissolved Neutral Molecules -->
                                <g transform="translate(106, 32)">
                                    <rect x="0" y="0" width="58" height="54" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                                    <line x1="2" y1="14" x2="56" y2="14" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="2,1"/>
                                    <ellipse cx="16" cy="24" rx="5.5" ry="4" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="40" cy="26" rx="5.5" ry="4" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="28" cy="40" rx="5.5" ry="4" fill="#0284c7" opacity="0.75"/>
                                    <text x="29" y="69" font-size="9" font-weight="bold" fill="#475569" text-anchor="middle">중성 분자로 분산</text>
                                </g>

                                <!-- Arrow 2 -->
                                <path d="M 172 60 L 196 60" fill="none" stroke="#0284c7" stroke-width="1.8" marker-end="url(#arr-soft)"/>
                                <text x="184" y="52" font-size="8" font-weight="bold" fill="#0369a1" text-anchor="middle">전원 연결</text>

                                <!-- Electrolysis Beaker (Neutral Molecules Floating) -->
                                <g transform="translate(204, 22)">
                                    <rect x="15" y="18" width="62" height="48" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                                    <line x1="17" y1="28" x2="75" y2="28" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="2,1"/>
                                    <rect x="27" y="10" width="5" height="44" fill="#94a3b8"/>
                                    <rect x="60" y="10" width="5" height="44" fill="#94a3b8"/>
                                    <text x="21" y="26" font-size="8.5" font-weight="900" fill="#2563eb" text-anchor="middle">(-)</text>
                                    <text x="69" y="26" font-size="8.5" font-weight="900" fill="#dc2626" text-anchor="middle">(+)</text>
                                    
                                    <ellipse cx="38" cy="38" rx="5" ry="4" fill="#0284c7" opacity="0.75"/>
                                    <ellipse cx="52" cy="40" rx="5" ry="4" fill="#0284c7" opacity="0.75"/>
                                    
                                    <path d="M 29.5 10 L 29.5 0 L 115 0 L 115 10 L 62.5 10" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
                                    <circle cx="75" cy="0" r="9.5" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                                    <text x="75" y="0.5" font-size="7.5" font-weight="900" fill="#64748b" text-anchor="middle" dominant-baseline="central">OFF</text>
                                    
                                    <text x="120" y="34" font-size="10.5" font-weight="900" fill="#64748b">전류 안 흐름 (✕)</text>
                                    <text x="120" y="47" font-size="8.5" font-weight="bold" fill="#475569">전구 OFF (이온 없음)</text>
                                </g>
                            </g>
                        </svg>
                    </div>

                    <!-- Bottom 3-Card Summary Box -->
                    <div class="content-box" style="height: 100px; display: flex; align-items: center; justify-content: center;">
                        <svg width="430" height="92" viewBox="0 0 430 92">
                            <!-- Card 1: Solid Ionic -->
                            <g transform="translate(10, 2)">
                                <rect x="0" y="0" width="125" height="88" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.2"/>
                                <rect x="6" y="6" width="113" height="18" rx="4" fill="#f1f5f9"/>
                                <text x="62.5" y="18" font-size="9" font-weight="bold" fill="#475569" text-anchor="middle">이온 결합 물질 (고체)</text>
                                <circle cx="62.5" cy="42" r="9.5" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1.2"/>
                                <text x="62.5" y="45" font-size="7" font-weight="bold" fill="#64748b" text-anchor="middle">OFF</text>
                                <text x="62.5" y="66" font-size="9.5" font-weight="800" fill="#64748b" text-anchor="middle">전기 안 통함 (✕)</text>
                                <text x="62.5" y="78" font-size="7.5" fill="#64748b" text-anchor="middle">이온 이동 불가(구속)</text>
                            </g>

                            <!-- Card 2: Liquid/Aqueous Ionic -->
                            <g transform="translate(150, 2)">
                                <rect x="0" y="0" width="130" height="88" rx="6" fill="#f0f9ff" stroke="#bae6fd" stroke-width="1.5"/>
                                <rect x="6" y="6" width="118" height="18" rx="4" fill="#e0f2fe"/>
                                <text x="65" y="18" font-size="9" font-weight="bold" fill="#0369a1" text-anchor="middle">이온 결합 물질 (액체/수용액)</text>
                                <circle cx="65" cy="42" r="9.5" fill="#fef08a" stroke="#eab308" stroke-width="1.2"/>
                                <text x="65" y="45" font-size="7" font-weight="bold" fill="#854d0e" text-anchor="middle">ON</text>
                                <text x="65" y="66" font-size="9.5" font-weight="800" fill="#15803d" text-anchor="middle">전기 잘 통함 (◯)</text>
                                <text x="65" y="78" font-size="7.5" fill="#0369a1" text-anchor="middle">이온이 자유롭게 이동</text>
                            </g>

                            <!-- Card 3: Covalent -->
                            <g transform="translate(293, 2)">
                                <rect x="0" y="0" width="125" height="88" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.2"/>
                                <rect x="6" y="6" width="113" height="18" rx="4" fill="#f1f5f9"/>
                                <text x="62.5" y="18" font-size="9" font-weight="bold" fill="#475569" text-anchor="middle">공유 결합 물질 (고체/수용액)</text>
                                <circle cx="62.5" cy="42" r="9.5" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1.2"/>
                                <text x="62.5" y="45" font-size="7" font-weight="bold" fill="#64748b" text-anchor="middle">OFF</text>
                                <text x="62.5" y="66" font-size="9.5" font-weight="800" fill="#64748b" text-anchor="middle">대부분 안 통함 (✕)</text>
                                <text x="62.5" y="78" font-size="7.5" fill="#64748b" text-anchor="middle">전하 띤 입자(이온) 없음</text>
                            </g>
                        </svg>
                    </div>

                    <div class="sub-box">
                        <div class="sub-box-title">■ 수용액 상태의 전기 전도성 보충:</div>
                        <ul class="bullet-list">
                            <li><b>이온 결합 물질(NaCl 등):</b> 물에 녹으면 양이온(Na⁺)과 음이온(Cl⁻)으로 이온화되어 전극 방향으로 자유롭게 이동하므로 <b>전류가 잘 흐름(전구 💡 ON)</b>.</li>
                            <li><b>공유 결합 물질(설탕 등):</b> 물에 녹아도 이온으로 나누어지지 않고 중성 분자 상태로 존재하므로 <b>전류가 흐르지 않음(전구 OFF)</b>.</li>
                        </ul>
                    </div>
                </div>

                
            
<div class="page-num">- 08 -</div>
</div>
</div>

<div class="page-wrapper page-scope-page09" style="margin-top: 40px; display: flex; justify-content: center;">
<div class="a4-page concept-page page-right">

                <h3 class="schema-title">갓쌤의 실전 암기장 ✍️</h3>

                <!-- 1. 화학 결합의 형성 원리 -->
                <div class="memo-section">
                    <div class="handwriting" style="margin-bottom: 6px;">
                    <span style="color:#b91c1c; font-weight:bold;">1. 화학 결합의 형성 원리</span><br/>
                    원소들은 옥텟 규칙(비활성 기체와 같은 전자 배치)을 만족하여 <span style="color:#2563eb; font-weight:bold;">안정한 상태</span>가 되기 위해 전자를 얻거나 잃거나 공유하며 결합해!
                </div>

                <!-- Graphic 1: Ionic vs Covalent Bond Summary -->
                <div style="height: 65px; display: flex; justify-content: center; align-items: center; margin-bottom: 8px; background: rgba(255,255,255,0.9); border: 1px stroke #cbd5e1; border-radius: 6px; padding: 4px;">
                    <svg width="420" height="60" viewBox="0 0 420 60">
                        <!-- Ionic Box -->
                        <g transform="translate(10, 5)">
                            <rect x="0" y="0" width="195" height="50" rx="6" fill="#f0f9ff" stroke="#0284c7" stroke-width="1.2"/>
                            <text x="97.5" y="16" font-size="10" font-weight="900" fill="#0369a1" text-anchor="middle">이온 결합 (금속 + 비금속)</text>
                            <text x="97.5" y="32" font-size="8.5" font-weight="500" fill="#334155" text-anchor="middle">금속(전자 잃음, 양이온) + 비금속(전자 얻음, 음이온)</text>
                            <text x="97.5" y="44" font-size="8" font-weight="bold" fill="#0284c7" text-anchor="middle">👉 정전기적 인력 작용</text>
                        </g>
                        <!-- Covalent Box -->
                        <g transform="translate(215, 5)">
                            <rect x="0" y="0" width="195" height="50" rx="6" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.2"/>
                            <text x="97.5" y="16" font-size="10" font-weight="900" fill="#be123c" text-anchor="middle">공유 결합 (비금속 + 비금속)</text>
                            <text x="97.5" y="32" font-size="8.5" font-weight="500" fill="#334155" text-anchor="middle">비금속 원자들이 서로 전자를 내놓아 전자쌍 공유</text>
                            <text x="97.5" y="44" font-size="8" font-weight="bold" fill="#e11d48" text-anchor="middle">👉 공유 전자쌍 형성</text>
                        </g>
                    </svg>
                </div>
                </div>

                <!-- 2. 이온 결합 vs 공유 결합 핵심 비교표 -->
                <div class="memo-section">
                    <div class="handwriting" style="margin-bottom: 4px;">
                    <span style="color:#b91c1c; font-weight:bold;">2. 이온 결합 물질 vs 공유 결합 물질 비교 (핵심 시험 포인트)</span>
                </div>
                <table class="hw-table">
                    <thead>
                        <tr>
                            <th style="width: 22%;">구분</th>
                            <th style="width: 39%;">이온 결합 물질 (예: NaCl)</th>
                            <th style="width: 39%;">공유 결합 물질 (예: H₂O, 설탕)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">구성 원소</td>
                            <td>금속 원소 + 비금속 원소</td>
                            <td>비금속 원소 + 비금속 원소</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">결합의 힘</td>
                            <td>양이온과 음이온의 정전기적 인력</td>
                            <td>원자핵과 공유 전자쌍 사이의 인력</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">상온 상태 / 구조</td>
                            <td>대부분 <b>고체</b> (이온 결정)</td>
                            <td>기체, 액체, 고체 (대부분 <b>분자</b>)</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">녹는점 · 끓는점</td>
                            <td>비교적 <span style="color:#b91c1c; font-weight:bold;">높음</span> (강한 인력)</td>
                            <td>비교적 <span style="color:#2563eb; font-weight:bold;">낮음</span> (분자간 인력 약함)</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">전기 전도성 (고체)</td>
                            <td><span style="color:#dc2626; font-weight:bold;">없음 (✕)</span> (이온 이동 불가)</td>
                            <td><span style="color:#dc2626; font-weight:bold;">없음 (✕)</span> (전하 입자 없음)</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; background: #f8fafc;">전기 전도성 (액체/수용액)</td>
                            <td><span style="color:#16a34a; font-weight:bold;">있음 (◯)</span> (이온이 자유롭게 이동)</td>
                            <td><span style="color:#dc2626; font-weight:bold;">없음 (✕)</span> (중성 분자로 존재)</td>
                        </tr>
                    </tbody>
                </table>
                </div>

                <!-- 3. 이온 결합 물질의 변형 (충격 시 쪼개짐 원리) -->
                <div class="memo-section">
                    <div class="handwriting" style="margin-bottom: 4px;">
                        <span style="color:#b91c1c; font-weight:bold;">3. 이온 결합 물질에 충격을 가할 때 변형 (쪼개짐 원리)</span>
                    </div>
                    <div style="border: 1px dashed #cbd5e1; border-radius: 6px; padding: 8px 12px; background: rgba(255,255,255,0.95); display: flex; flex-direction: row; align-items: center; gap: 10px;">
                        <!-- SVG Hammer Shattering Diagram -->
                        <svg width="180" height="85" viewBox="0 0 180 85">
                            <!-- Left: Normal State -->
                            <g transform="translate(5, 5)">
                                <rect x="0" y="0" width="60" height="60" rx="4" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
                                <!-- Row 1 -->
                                <circle cx="15" cy="15" r="7" fill="#f59e0b"/><text x="15" y="15.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">+</text>
                                <circle cx="45" cy="15" r="7" fill="#10b981"/><text x="45" y="15.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <!-- Row 2 -->
                                <circle cx="15" cy="45" r="7" fill="#10b981"/><text x="15" y="45.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <circle cx="45" cy="45" r="7" fill="#f59e0b"/><text x="45" y="45.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">+</text>
                                <text x="30" y="74" font-size="7.5" font-weight="bold" fill="#0369a1" text-anchor="middle">정전기적 인력</text>
                            </g>

                            <!-- Arrow & Impact -->
                            <g transform="translate(70, 25)">
                                <path d="M 0 10 L 22 10" stroke="#ef4444" stroke-width="2" marker-end="url(#arr-red)"/>
                                <text x="11" y="2" font-size="7.5" font-weight="900" fill="#ef4444" text-anchor="middle">외부 충격</text>
                            </g>

                            <!-- Right: Shifted & Repelling State -->
                            <g transform="translate(100, 5)">
                                <rect x="0" y="0" width="70" height="60" rx="4" fill="#fff1f2" stroke="#fecdd3" stroke-width="1"/>
                                <!-- Row 1 shifted right -->
                                <circle cx="25" cy="15" r="7" fill="#f59e0b"/><text x="25" y="15.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">+</text>
                                <circle cx="55" cy="15" r="7" fill="#10b981"/><text x="55" y="15.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                <!-- Row 2 normal -->
                                <circle cx="25" cy="45" r="7" fill="#f59e0b"/><text x="25" y="45.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">+</text>
                                <circle cx="55" cy="45" r="7" fill="#10b981"/><text x="55" y="45.5" font-size="7" font-weight="900" fill="#fff" text-anchor="middle" dominant-baseline="central">-</text>
                                
                                <!-- Repulsion arrows between ++ and -- -->
                                <path d="M 25 24 L 25 36" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="2,1"/>
                                <path d="M 55 24 L 55 36" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="2,1"/>
                                <text x="35" y="74" font-size="7.5" font-weight="900" fill="#dc2626" text-anchor="middle">반발력 ➔ 쪼개짐!</text>
                            </g>
                        </svg>
                        
                        <div style="font-size: 8.5px; color: #1e293b; flex: 1;">
                            <div class="indent-item">• 이온 결합 물질은 결정 구조가 단단하지만, <b>외부에서 충격을 가하면 이온 층이 밀리게 됨</b>.</div>
                            <div class="indent-item">• 이온 층이 밀려 <span style="color:#b91c1c; font-weight:bold;">같은 전하를 띤 이온끼리 마주치게 되면서 강한 반발력</span>이 작용함.</div>
                            <div class="indent-item">• 따라서 이온 결정은 변형되지 않고 <span style="color:#2563eb; font-weight:bold;">쉽게 쪼개지거나 부서지는 성질</span>을 가짐!</div>
                        </div>
                    </div>
                </div>

                <!-- 갓쌤의 출제 포인트 포스트잇 팁 -->
                <div class="tip-sticky">
                    📌 <strong>갓쌤의 출제 포인트!</strong>
                    <div class="tip-list">
                        <div class="tip-item">
                            1. <span style="color:#b91c1c; font-weight:bold;">전기 전도성 판단 법칙</span>: 고체에서 ✕, 액체/수용액에서 ◯이면 무조건 <b>이온 결합 물질</b>! 액체에서도 ✕이면 <b>공유 결합 물질</b>이야!
                        </div>
                        <div class="tip-item">
                            2. <span style="color:#2563eb; font-weight:bold;">충격 시 쪼개짐 원리</span>: 이온 결합 물질은 강한 인력으로 단단하지만 외부 충격을 받으면 <b>이온 층이 밀려 같은 전하끼리 반발력</b>이 작용해 쉽게 쪼개진다는 선지가 단골 출제돼!
                        </div>
                    </div>
                </div>

                
            
<div class="page-num">- 09 -</div>
</div>
</div>

