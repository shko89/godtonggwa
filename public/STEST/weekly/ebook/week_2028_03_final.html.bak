                <circle cx="8.08" cy="33.5" r="3" fill="url(#e-grad)"/>
                <circle cx="8.08" cy="10.5" r="3" fill="url(#e-grad)"/>
                <text x="28" y="65" font-size="8.5" font-weight="bold" fill="#0f172a" text-anchor="middle">산소(O)</text>
            </g>
            <text x="130" y="34" font-size="12" font-weight="bold" fill="#64748b">+</text>

            <!-- Right H -->
            <g transform="translate(140, 10)">
                <circle cx="22" cy="22" r="16" fill="none" stroke="#38bdf8" stroke-width="1.3"/>
                <circle cx="22" cy="22" r="5.5" fill="url(#nuc-red)"/>
