    </radialGradient>
    <radialGradient id="e-grad" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#93c5fd" />
        <stop offset="50%" stop-color="#2563eb" />
        <stop offset="100%" stop-color="#1e3a8a" />
    </radialGradient>
    <marker id="arr-b" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#0284c7"/></marker>
</defs>

        <g transform="translate(0, 0)">
            <!-- Left H -->
            <g transform="translate(10, 10)">
                <circle cx="22" cy="22" r="16" fill="none" stroke="#38bdf8" stroke-width="1.3"/>
                <circle cx="22" cy="22" r="5.5" fill="url(#nuc-red)"/>
                <text x="22" y="22.5" font-size="6.5" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">+1</text>
                <circle cx="38.0" cy="22.0" r="3" fill="url(#e-grad)"/>
                <text x="38.0" y="22.4" font-size="4" font-weight="900" fill="#ffffff" text-anchor="middle" dominant-baseline="central">-</text>
                <text x="22" y="65" font-size="8.5" font-weight="bold" fill="#0f172a" text-anchor="middle">수소(H)</text>
            </g>
            <text x="54" y="34" font-size="12" font-weight="bold" fill="#64748b">+</text>

            <!-- Oxygen O -->
            <g transform="translate(66, 10)">
                <circle cx="28" cy="22" r="23" fill="none" stroke="#38bdf8" stroke-width="1.3"/>
                <circle cx="28" cy="22" r="12" fill="none" stroke="#cbd5e1" stroke-width="1"/>
