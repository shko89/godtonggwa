        .section-label { font-family: 'Roboto'; font-weight: 900; font-size: 14px; color: #0284c7; margin-bottom: 5px; }
        .data-title { font-size: 28px; font-weight: 900; color: #0f172a; margin: 0; letter-spacing: -1px; }
        .info-box { margin-top: 30px; }
        .info-box-title { font-size: 15px; font-weight: 900; color: #1e293b; margin-bottom: 15px; }
        .svg-container { height: 200px; display: flex; justify-content: center; align-items: center; background: #f8fafc; border-radius: 12px; border: 1.5px dashed #cbd5e1; margin-bottom: 20px; }
        .explanation-box { padding: 20px 25px; background-color: #f8fafc; border-radius: 12px; border: 1px solid #cbd5e1; font-size: 13px; color: #334155; line-height: 1.6; text-align: justify; word-break: keep-all; }
        .page-num { position: absolute; bottom: 0px; width: 100%; text-align: center; color: #64748b; font-weight: 700; font-size: 13px; }
        .concept-spread { display: flex; width: 100%; height: 100%; }
        .schema-title { font-size: 24px; font-weight: 900; color: #0f172a; margin-bottom: 25px; border-bottom: 2px solid #94a3b8; padding-bottom: 12px; }
        .handwriting { background-color: #f8fafc; background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px); background-size: 20px 20px; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 20px 25px; margin-bottom: 25px; font-size: 15px; color: #334155; line-height: 1.7; font-weight: 600; text-align: justify; word-break: keep-all; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
        .svg-container { height: 140px; display: flex; justify-content: center; align-items: center; margin-bottom: 25px; background: #ffffff; border-radius: 8px; border: 1.5px dashed #cbd5e1; }
        .hw-table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 13px; }
        .hw-table th { background-color: #f1f5f9; padding: 12px; border: 1px solid #cbd5e1; font-weight: 900; color: #334155; text-align: center; }
        .hw-table td { padding: 12px; border: 1px solid #cbd5e1; color: #475569; font-weight: 600; text-align: center; }
        .page-num { position: absolute; bottom: 0px; width: 100%; text-align: center; color: #64748b; font-weight: 700; font-size: 13px; }
/* ========================================================
   Concept Bridge (page04) Node Positioning & Styling
   ======================================================== */
.node.main {
    top: 10px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: 260px !important;
    background-color: #0f172a !important;
    border-radius: 8px !important;
    padding: 12px !important;
    text-align: center !important;
    position: absolute !important;
    z-index: 10 !important;
}
.node.main .node-title {
    color: #ffffff !important;
    font-size: 14px !important;
    font-weight: 900 !important;
    margin-bottom: 4px !important;
}
.node.main .node-desc {
    color: #94a3b8 !important;
    font-size: 10.5px !important;
}
.node.sub {
    top: 100px !important;
    width: 190px !important;
    background-color: #ffffff !important;
    border: 2px solid #0ea5e9 !important;
    border-radius: 8px !important;
    padding: 10px !important;
    text-align: center !important;
    position: absolute !important;
    z-index: 10 !important;
}
.node.sub .node-title {
    color: #1d4ed8 !important;
    font-size: 13px !important;
    font-weight: 900 !important;
    margin-bottom: 4px !important;
}
.node.sub .node-desc {
    color: #64748b !important;
    font-size: 10px !important;
}
.node.leaf {
    background-color: #f8fafc !important;
    border: 1.5px solid #cbd5e1 !important;
    border-radius: 6px !important;
    text-align: center !important;
    position: absolute !important;
    z-index: 10 !important;
}
.node.leaf .font-bold {
    color: #0f172a !important;
    font-size: 11px !important;
    font-weight: 900 !important;
    margin-bottom: 5px !important;
    line-height: 1.2 !important;
    word-break: keep-all !important;
}
.node.leaf .desc {
    color: #64748b !important;
    font-size: 9px !important;
    line-height: 1.35 !important;
    word-break: keep-all !important;
}
.node.leaf.red {
    border-color: #fca5a5 !important;
    background-color: #fef2f2 !important;
}
.node.leaf.red .font-bold {
    color: #dc2626 !important;
}
/* Bridge Page Header & Padding Match Week 2 */
.a4-page.bridge-page {
    padding: 30px 40px 40px 40px !important;
}
/* Week 2 Gold Standard Concept Bridge Node Styles */
.node { box-sizing: border-box; position: absolute; background: white; border: 2px solid #cbd5e1; border-radius: 12px; padding: 8px 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); text-align: center; z-index: 10; }
.node.main { border-color: #0f172a; border-width: 3px; background: #0f172a; color: white; padding: 12px 16px; }
.node.sub { border-color: #0284c7; border-left-width: 6px; }
.node.leaf { border-color: #94a3b8; font-size: 12px; padding: 8px 12px; border-radius: 8px; box-shadow: none; background: #f8fafc; }
.node-title { font-weight: 800; font-size: 15px; margin-bottom: 4px; letter-spacing: -0.5px; color: #1d4ed8; }
.node-desc { font-size: 11px; font-weight: 400; opacity: 0.9; letter-spacing: -0.5px; line-height: 1.3; color: #475569; }
.leaf .font-bold { font-weight: 700; color: #1e293b; }
.leaf .desc { font-size: 10px; color: #64748b; margin-top: 4px; }
.leaf.red { border-color: #fca5a5; background-color: #fef2f2; }
.leaf.red .font-bold { color: #dc2626; }
.leaf.red .desc { color: #475569; }
/* ========================================================
   EXACT WEEK 2 CONCEPT BRIDGE HEADER & CONTAINER STYLES
   ======================================================== */
.bridge-page {
    padding: 30px 40px 50px 40px !important;
    background-color: #ffffff !important;
    display: flex;
    flex-direction: column !important;
}
.page-header {
    display: flex;
    justify-content: space-between !important;
    align-items: flex-end !important;
    border-bottom: 2px solid #cbd5e1 !important;
    padding-bottom: 10px !important;
    margin-bottom: 20px !important;
}
.header-brand {
    font-family: 'Roboto', sans-serif !important;
    font-weight: 900 !important;
    font-size: 13px !important;
    letter-spacing: 2px !important;
    color: #94a3b8 !important;
}
.bridge-title {
    font-family: 'Roboto', sans-serif !important;
    font-weight: 900 !important;
    font-size: 32px !important;
    letter-spacing: -1px !important;
    color: #0284c7 !important;
    margin: 0 !important;
    line-height: 1 !important;
}
.bridge-sub {
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #475569 !important;
    margin-top: 8px !important;
}
.map-container {
    flex-grow: 1 !important;
    position: relative !important;
    margin-top: 15px !important;
    display: flex;
    flex-direction: column !important;
    transform: scale(0.9) !important;
    transform-origin: top center !important;
    min-height: 400px !important;
}
/* ========================================================
   WEEK 2 GOLD STANDARD NODE DESIGN SYSTEM (100% MATCH)
   ======================================================== */
.node { 
    box-sizing: border-box !important; 
    position: absolute !important; 
    background: #ffffff !important; 
    border: 2px solid #cbd5e1 !important; 
    border-radius: 12px !important; 
    padding: 8px 6px !important; 
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1) !important; 
    text-align: center !important; 
    z-index: 10 !important; 
    font-family: 'Noto Sans KR', sans-serif !important;
}
/* 1열 상자 (메인 검은색 상자) */
.node.main { 
    border-color: #0f172a !important; 
    border-width: 3px !important; 
    background: #0f172a !important; 
    color: #ffffff !important; 
    padding: 12px 16px !important; 
    border-radius: 12px !important;
}
.node.main .node-title { 
    color: #ffffff !important; 
    font-size: 15px !important; 
    font-weight: 800 !important; 
    margin-bottom: 4px !important; 
    letter-spacing: -0.5px !important; 
    font-family: 'Noto Sans KR', sans-serif !important;
}
.node.main .node-desc { 
    color: #ffffff !important; 
    opacity: 0.9 !important; 
    font-size: 11px !important; 
    font-weight: 400 !important; 
    letter-spacing: -0.5px !important; 
    line-height: 1.3 !important; 
    font-family: 'Noto Sans KR', sans-serif !important;
}
/* 2열 상자 (서브 파란색 테두리 상자 - 좌측 6px 두꺼운 포인트 테두리) */
.node.sub { 
    background: #ffffff !important;
    border-color: #0284c7 !important; 
    border-width: 2px 2px 2px 6px !important; /* 좌측 6px 두껍게 */
    border-radius: 12px !important;
    padding: 10px !important;
}
.node.sub .node-title { 
    color: #1d4ed8 !important; 
    font-size: 15px !important; 
    font-weight: 800 !important; 
    margin-bottom: 4px !important; 
    letter-spacing: -0.5px !important; 
    font-family: 'Noto Sans KR', sans-serif !important;
}
.node.sub .node-desc { 
    color: #475569 !important; 
    font-size: 11px !important; 
    font-weight: 400 !important; 
    opacity: 0.9 !important; 
    letter-spacing: -0.5px !important; 
    line-height: 1.3 !important; 
    font-family: 'Noto Sans KR', sans-serif !important;
}
/* 3열 상자 (하단 일반 개념 상자) */
.node.leaf { 
    border-color: #94a3b8 !important; 
    font-size: 12px !important; 
    padding: 8px 12px !important; 
    border-radius: 8px !important; 
    box-shadow: none !important; 
    background: #f8fafc !important; 
}
.node.leaf .font-bold { 
    font-weight: 700 !important; 
    color: #1e293b !important; 
    font-size: 11px !important;
    font-family: 'Noto Sans KR', sans-serif !important;
    margin-bottom: 4px !important;
}
.node.leaf .desc { 
    font-size: 10px !important; 
    color: #64748b !important; 
    margin-top: 4px !important; 
    line-height: 1.35 !important;
    font-family: 'Noto Sans KR', sans-serif !important;
}
/* 3열 붉은색 강조 상자 */
.node.leaf.red { 
    border-color: #fca5a5 !important; 
    background-color: #fef2f2 !important; 
}
.node.leaf.red .font-bold { 
    color: #dc2626 !important; 
}
.node.leaf.red .desc { 
    color: #475569 !important; 
}
/* 출제자의 시선 박스 */
.insight-box { 
    width: 100% !important; 
    box-sizing: border-box !important; 
    background-color: #1e293b !important; 
    border-radius: 12px !important; 
    padding: 16px !important; 
    color: #ffffff !important; 
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1) !important; 
    margin-top: auto !important; 
    z-index: 20 !important; 
    position: relative !important; 
    transform: translateY(-20px) !important; 
}
